<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Interface Client - VetCare</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: Arial, sans-serif; background: #f4f6f9; min-height: 100vh; color: #333; }
.container { max-width: 1400px; margin: 2rem auto; padding: 2rem; background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }

.header { text-align: center; margin-bottom: 3rem; }
.header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; color: #2c3e50; }
.header p { color: #6c757d; font-size: 1.1rem; }

/* Recherche */
.search-container { margin: 2rem 0; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
.search-container input, .search-container select { padding: 0.8rem 1rem; min-width: 250px; flex-grow: 1; border-radius: 5px; border: 1px solid #ced4da; font-size: 1rem; }
.btn { padding: 0.8rem 1.5rem; background:#2c5f2d; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: 600; transition: 0.3s; }
.btn:hover { background: #0056b3; }
.btn-secondary { background: #6c757d; }
.btn-secondary:hover { background: #5a6268; }
.btn-success { background: #28a745; }
.btn-success:hover { background: #218838; }

/* Carte */
.map-section { margin: 3rem 0; display: none; }
.map-section.active { display: block; animation: fadeIn 0.5s ease; }
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}
.map-header { background: #6c757d; padding: 1.5rem; border-radius: 10px 10px 0 0; color: white; display: flex; justify-content: space-between; align-items: center; }
.map-header h2 { margin: 0; display: flex; align-items: center; gap: 10px; }
.map-controls { display: flex; gap: 1rem; background: #e9ecef; padding: 1rem; border-radius: 0 0 10px 10px; flex-wrap: wrap; }
.map-controls input, .map-controls select { flex: 1; min-width: 200px; padding: 0.8rem 1rem; border: 1px solid #ced4da; border-radius: 5px; font-size: 1rem; }
.map-controls button { padding: 0.8rem 1.5rem; background: #6c757d; color: white; border: none; border-radius: 5px; cursor: pointer; transition: 0.3s; }
.map-controls button:hover { background: #5a6268; }
#pharmacies-map { height: 500px; width: 100%; border-radius: 0 0 10px 10px; }

/* Tables */
.tables-container { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem; }
@media (max-width: 768px) { .tables-container { grid-template-columns: 1fr; } }
.table-section { background: #fff; margin-bottom: 30px; border-radius: 8px; box-shadow: 0 3px 10px rgba(0,0,0,0.1); overflow: hidden; }
.table-header { padding: 15px; background:#2c5f2d; color: white; }
.table-body { padding: 15px; overflow-x: auto; max-height: 400px; overflow-y: auto; }
.data-table { width: 100%; border-collapse: collapse; }
.data-table th, .data-table td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; }
.data-table th { background: #f1f1f1; color: #333; }
.stock-indicator { font-weight: bold; }
.statut-badge { display: inline-block; padding: 5px 10px; border-radius: 12px; color: #fff; font-size: 0.85rem; }
.horaire-badge { display: inline-block; padding: 5px 10px; border-radius: 12px; font-size: 0.85rem; font-weight: bold; }
.horaire-jour { background: #ffc107; color: #212529; }
.horaire-nuit { background: #343a40; color: white; }
.horaire-24h { background: #17a2b8; color: white; }
.empty-message { text-align: center; color: #777; padding: 15px; }

.actions { text-align: center; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #dee2e6; }

/* Statistiques */
.stats-container { background: #f8f9fa; padding: 1.5rem; border-radius: 8px; margin: 2rem 0; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 1rem; }
.stat-card { background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 3px 10px rgba(0,0,0,0.1); text-align: center; }
.stat-card i { font-size: 2rem; margin-bottom: 0.5rem; color: #007bff; }
.stat-card h4 { margin: 0.5rem 0; color: #495057; }
.stat-card .stat-value { font-size: 2rem; font-weight: bold; color: #2c3e50; }
.stat-card .stat-detail { color: #6c757d; font-size: 0.9rem; margin-top: 0.5rem; }

/* Légende */
.legend { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin: 1rem 0; }
.legend-item { display: flex; align-items: center; gap: 0.5rem; }

/* Erreur */
.error-message { background: #dc3545; color: white; padding: 1rem; border-radius: 5px; margin: 1rem 0; text-align: center; display: none; }
.error-message.active { display: block; }

/* Tooltip */
.tooltip { position: relative; display: inline-block; }
.tooltip .tooltiptext { visibility: hidden; width: 200px; background-color: #333; color: #fff; text-align: center; border-radius: 6px; padding: 10px; position: absolute; z-index: 1; bottom: 125%; left: 50%; margin-left: -100px; opacity: 0; transition: opacity 0.3s; font-size: 0.9rem; }
.tooltip:hover .tooltiptext { visibility: visible; opacity: 1; }
</style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1><i class="fas fa-clinic-medical"></i> Interface Client - VetCare</h1>
        <p>Consultation de toutes les pharmacies de Tunisie avec horaires</p>
    </div>

    <!-- Message d'erreur -->
    <div id="map-error" class="error-message">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Erreur Google Maps :</strong> La carte ne peut pas se charger.
    </div>

    <!-- Recherche -->
    <div class="search-container">
        <select id="governorate-select">
            <option value="">Tous les gouvernorats</option>
            <!-- Options seront générées par JavaScript -->
        </select>
        <select id="horaire-select">
            <option value="">Tous les horaires</option>
            <option value="jour">De jour seulement</option>
            <option value="nuit">De nuit seulement</option>
            <option value="24h">24h/24</option>
        </select>
        <button id="search-btn" class="btn"><i class="fas fa-search"></i> Rechercher</button>
        <button id="show-all-btn" class="btn btn-success"><i class="fas fa-eye"></i> Toutes les pharmacies</button>
        <button id="locate-btn" class="btn btn-secondary"><i class="fas fa-location-arrow"></i> Ma position</button>
    </div>

    <!-- Légende -->
    <div class="legend">
        <div class="legend-item">
            <div style="width: 15px; height: 15px; background: #ffc107; border-radius: 50%;"></div>
            <span>Pharmacie de jour</span>
        </div>
        <div class="legend-item">
            <div style="width: 15px; height: 15px; background: #343a40; border-radius: 50%;"></div>
            <span>Pharmacie de nuit</span>
        </div>
        <div class="legend-item">
            <div style="width: 15px; height: 15px; background: #17a2b8; border-radius: 50%;"></div>
            <span>Pharmacie 24h/24</span>
        </div>
        <div class="legend-item">
            <div style="width: 15px; height: 15px; background: #007bff; border-radius: 50%;"></div>
            <span>Votre position</span>
        </div>
    </div>

    <!-- Statistiques détaillées -->
    <div class="stats-container">
        <h3><i class="fas fa-chart-bar"></i> Statistiques des pharmacies</h3>
        <div class="stats-grid">
            <div class="stat-card">
                <i class="fas fa-clinic-medical"></i>
                <h4>Total des pharmacies</h4>
                <div class="stat-value" id="total-count">0</div>
                <div class="stat-detail">en Tunisie</div>
            </div>
            <div class="stat-card">
                <i class="fas fa-map-marked-alt"></i>
                <h4>Gouvernorats couverts</h4>
                <div class="stat-value" id="governorate-count">0</div>
                <div class="stat-detail">sur 24 gouvernorats</div>
            </div>
            <div class="stat-card">
                <i class="fas fa-sun"></i>
                <h4>Pharmacies de jour</h4>
                <div class="stat-value" id="jour-count">0</div>
                <div class="stat-detail">ouvertes le jour</div>
            </div>
            <div class="stat-card">
                <i class="fas fa-moon"></i>
                <h4>Pharmacies de nuit</h4>
                <div class="stat-value" id="nuit-count">0</div>
                <div class="stat-detail">ouvertes la nuit</div>
            </div>
            <div class="stat-card">
                <i class="fas fa-clock"></i>
                <h4>Pharmacies 24h</h4>
                <div class="stat-value" id="24h-count">0</div>
                <div class="stat-detail">ouvertes 24h/24</div>
            </div>
            <div class="stat-card">
                <i class="fas fa-eye"></i>
                <h4>Affichées actuellement</h4>
                <div class="stat-value" id="displayed-count">0</div>
                <div class="stat-detail" id="displayed-detail">sur la carte</div>
            </div>
        </div>
    </div>

    <!-- Carte -->
    <div class="map-section" id="map-section">
        <div class="map-header">
            <h2 id="map-title"><i class="fas fa-map-marked-alt"></i> Pharmacies de Tunisie</h2>
            <button id="close-map" class="btn" style="background: #dc3545;">
                <i class="fas fa-times"></i> Fermer
            </button>
        </div>
        <div class="map-controls">
            <input type="text" id="search-pharmacy" placeholder="Rechercher par nom de pharmacie...">
            <select id="filter-horaire-map">
                <option value="">Tous les horaires</option>
                <option value="jour">De jour seulement</option>
                <option value="nuit">De nuit seulement</option>
                <option value="24h">24h/24</option>
            </select>
            <button id="zoom-in-btn"><i class="fas fa-search-plus"></i> Zoom +</button>
            <button id="zoom-out-btn"><i class="fas fa-search-minus"></i> Zoom -</button>
            <button id="reset-btn"><i class="fas fa-sync-alt"></i> Réinitialiser</button>
        </div>
        <div id="pharmacies-map"></div>
    </div>

    <!-- Liste des pharmacies -->
    <div class="table-section" id="pharmacies-list">
        <div class="table-header">
            <h2><i class="fas fa-list"></i> Liste des pharmacies (<span id="pharmacy-list-count">0</span>)</h2>
        </div>
        <div class="table-body">
            <table class="data-table" id="pharmacies-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Gouvernorat</th>
                        <th>Adresse</th>
                        <th>Téléphone</th>
                        <th>Horaires</th>
                    </tr>
                </thead>
                <tbody id="pharmacies-table-body">
                    <!-- Rempli par JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tables existantes (gardées pour compatibilité) -->
    <div class="tables-container">
        <div class="table-section" id="medicaments">
            <div class="table-header">
                <h2><i class="fas fa-pills"></i> Médicaments Disponibles</h2>
            </div>
            <div class="table-body">
                {% if medicaments is not empty %}
                <table class="data-table">
                    <thead><tr><th>Nom</th><th>Description</th><th>Stock</th></tr></thead>
                    <tbody>
                        {% for medicament in medicaments %}
                        <tr>
                            <td><strong>{{ medicament.nom }}</strong></td>
                            <td>{{ medicament.description|default('Aucune description')|slice(0, 50) }}{% if medicament.description and medicament.description|length > 50 %}...{% endif %}</td>
                            <td><span class="stock-indicator" style="color: {% if medicament.stock > 50 %}#28a745{% elseif medicament.stock > 20 %}#ffc107{% else %}#dc3545{% endif %};">{{ medicament.stock }} unités</span></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% else %}<div class="empty-message">Aucun médicament disponible</div>{% endif %}
            </div>
        </div>

        <div class="table-section" id="traitements">
            <div class="table-header">
                <h2><i class="fas fa-stethoscope"></i> Traitements en Cours</h2>
            </div>
            <div class="table-body">
                {% if traitements is not empty %}
                <table class="data-table">
                    <thead><tr><th>Nom</th><th>Description</th><th>Statut</th><th>Médicaments</th></tr></thead>
                    <tbody>
                        {% for traitement in traitements %}
                        <tr>
                            <td><strong>{{ traitement.nom }}</strong></td>
                            <td>{{ traitement.description|default('Aucune description')|slice(0, 50) }}{% if traitement.description and traitement.description|length > 50 %}...{% endif %}</td>
                            <td><span class="statut-badge" style="background: {% if traitement.statut == 'pending' %}#ffc107{% elseif traitement.statut == 'in_progress' %}#007bff{% elseif traitement.statut == 'completed' %}#28a745{% else %}#dc3545{% endif %};">{% if traitement.statut == 'pending' %}En attente{% elseif traitement.statut == 'in_progress' %}En cours{% elseif traitement.statut == 'completed' %}Terminé{% else %}Annulé{% endif %}</span></td>
                            <td>{{ traitement.medicaments|length }} médicament(s)</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% else %}<div class="empty-message">Aucun traitement disponible</div>{% endif %}
            </div>
        </div>
    </div>

    <div class="actions">
        <button id="toggle-pharmacies-btn" class="btn" style="background: #28a745;">
            <i class="fas fa-map-marker-alt"></i> Afficher/Cacher la carte
        </button>
    </div>
</div>

