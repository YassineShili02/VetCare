// Variables globales
let map;
let markers = [];
let currentZoom = 7;
let userLocationMarker = null;

// Initialisation Google Maps
function initMap() {
    try {
        const tunisieCenter = { lat: 34.0, lng: 9.0 };

        map = new google.maps.Map(document.getElementById("pharmacies-map"), {
            center: tunisieCenter,
            zoom: currentZoom,
            mapTypeControl: true,
            streetViewControl: false,
            fullscreenControl: true,
            zoomControl: true,
            styles: [
                {
                    featureType: "poi",
                    elementType: "labels",
                    stylers: [{ visibility: "off" }]
                }
            ]
        });

        document.getElementById('map-error').style.display = 'none';

        // Remplir le sélecteur de gouvernorats
        populateGovernorateSelect();

        // Afficher toutes les pharmacies au démarrage
        showAllPharmacies();

        updateStats();

    } catch (error) {
        console.error("Erreur Google Maps:", error);
        document.getElementById('map-error').style.display = 'block';
        document.getElementById('map-error').innerHTML = `
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Erreur Google Maps :</strong> ${error.message}<br>
            Vérifiez votre clé API ou votre connexion internet.
        `;
    }
}

// Remplir le sélecteur de gouvernorats
function populateGovernorateSelect() {
    const select = document.getElementById('governorate-select');
    const gouvernorats = Object.keys(pharmaciesTunisie).sort();

    gouvernorats.forEach(gouvernorat => {
        const option = document.createElement('option');
        option.value = gouvernorat;
        option.textContent = gouvernorat;
        select.appendChild(option);
    });
}

// Afficher toutes les pharmacies
function showAllPharmacies() {
    clearMarkers();

    let allPharmacies = [];
    Object.entries(pharmaciesTunisie).forEach(([gouvernorat, pharmaciesList]) => {
        pharmaciesList.forEach(pharmacie => {
            allPharmacies.push({
                ...pharmacie,
                gouvernorat: gouvernorat
            });
        });
    });

    displayPharmacies(allPharmacies);
    updateTable(allPharmacies);
}

// Afficher les pharmacies d'un gouvernorat spécifique
function showPharmaciesByGovernorate(gouvernoratName, horaireFilter = '') {
    clearMarkers();

    if (pharmaciesTunisie[gouvernoratName]) {
        let pharmaciesList = pharmaciesTunisie[gouvernoratName].map(p => ({
            ...p,
            gouvernorat: gouvernoratName
        }));

        // Appliquer le filtre d'horaire si spécifié
        if (horaireFilter) {
            pharmaciesList = pharmaciesList.filter(p => p.horaire === horaireFilter);
        }

        displayPharmacies(pharmaciesList);
        updateTable(pharmaciesList);

        // Mettre à jour le détail affiché
        document.getElementById('displayed-detail').textContent = `dans ${gouvernoratName}`;
    }
}

// Afficher les pharmacies sur la carte
function displayPharmacies(pharmaciesList) {
    if (!map) return;

    const bounds = new google.maps.LatLngBounds();

    pharmaciesList.forEach(pharmacie => {
        const position = { lat: pharmacie.lat, lng: pharmacie.lng };

        // Déterminer l'icône en fonction de l'horaire
        let iconUrl;
        let iconColor;

        switch(pharmacie.horaire) {
            case 'jour':
                iconUrl = "http://maps.google.com/mapfiles/ms/icons/yellow-dot.png";
                iconColor = '#ffc107';
                break;
            case 'nuit':
                iconUrl = "http://maps.google.com/mapfiles/ms/icons/black-dot.png";
                iconColor = '#343a40';
                break;
            case '24h':
                iconUrl = "http://maps.google.com/mapfiles/ms/icons/blue-dot.png";
                iconColor = '#17a2b8';
                break;
            default:
                iconUrl = "http://maps.google.com/mapfiles/ms/icons/red-dot.png";
                iconColor = '#dc3545';
        }

        const marker = new google.maps.Marker({
            position: position,
            map: map,
            title: pharmacie.name,
            icon: {
                url: iconUrl,
                scaledSize: new google.maps.Size(32, 32)
            }
        });

        const infoWindow = new google.maps.InfoWindow({
            content: `
                <div style="padding: 15px; max-width: 300px;">
                    <h3 style="margin: 0 0 10px 0; color: #2c3e50;">${pharmacie.name}</h3>
                    <p style="margin: 5px 0; color: #666;">
                        <i class="fas fa-map-marker-alt" style="color: ${iconColor};"></i>
                        ${pharmacie.adresse}
                    </p>
                    <p style="margin: 5px 0; color: #666;">
                        <i class="fas fa-city" style="color: ${iconColor};"></i>
                        ${pharmacie.gouvernorat}
                    </p>
                    <p style="margin: 5px 0; color: #666;">
                        <i class="fas fa-phone" style="color: ${iconColor};"></i>
                        ${pharmacie.phone}
                    </p>
                    <p style="margin: 5px 0; color: #666;">
                        <i class="fas fa-clock" style="color: ${iconColor};"></i>
                        Horaires: <strong>${getHoraireText(pharmacie.horaire)}</strong>
                    </p>
                </div>
            `
        });

        marker.addListener("click", () => {
            infoWindow.open(map, marker);
        });

        markers.push(marker);
        bounds.extend(position);
    });

    if (pharmaciesList.length > 0) {
        if (pharmaciesList.length === 1) {
            map.setCenter({ lat: pharmaciesList[0].lat, lng: pharmaciesList[0].lng });
            map.setZoom(15);
        } else {
            map.fitBounds(bounds);
        }
    }

    // Mettre à jour les statistiques
    updateStats(pharmaciesList.length);
    document.getElementById("map-title").innerHTML = `<i class="fas fa-map-marked-alt"></i> ${pharmaciesList.length} pharmacies`;
}

// Mettre à jour le tableau de liste
function updateTable(pharmaciesList) {
    const tbody = document.getElementById('pharmacies-table-body');
    tbody.innerHTML = '';

    pharmaciesList.forEach(pharmacie => {
        const row = document.createElement('tr');

        const horaireClass = `horaire-${pharmacie.horaire}`;
        const horaireText = getHoraireText(pharmacie.horaire);

        row.innerHTML = `
            <td><strong>${pharmacie.name}</strong></td>
            <td>${pharmacie.gouvernorat}</td>
            <td>${pharmacie.adresse}</td>
            <td>${pharmacie.phone}</td>
            <td><span class="horaire-badge ${horaireClass}">${horaireText}</span></td>
        `;

        tbody.appendChild(row);
    });

    document.getElementById('pharmacy-list-count').textContent = pharmaciesList.length;
}

// Obtenir le texte d'horaire
function getHoraireText(horaire) {
    switch(horaire) {
        case 'jour': return 'De jour (8h-20h)';
        case 'nuit': return 'De nuit (20h-8h)';
        case '24h': return '24h/24';
        default: return 'Non spécifié';
    }
}

// Effacer les marqueurs
function clearMarkers() {
    markers.forEach(marker => marker.setMap(null));
    markers = [];
}

// Mettre à jour les statistiques
function updateStats(displayedCount = 0) {
    let totalCount = 0;
    let jourCount = 0;
    let nuitCount = 0;
    let count24h = 0;

    Object.values(pharmaciesTunisie).forEach(pharmaciesList => {
        totalCount += pharmaciesList.length;
        pharmaciesList.forEach(pharmacie => {
            switch(pharmacie.horaire) {
                case 'jour': jourCount++; break;
                case 'nuit': nuitCount++; break;
                case '24h': count24h++; break;
            }
        });
    });

    const governorateCount = Object.keys(pharmaciesTunisie).length;

    document.getElementById("total-count").textContent = totalCount;
    document.getElementById("governorate-count").textContent = governorateCount;
    document.getElementById("jour-count").textContent = jourCount;
    document.getElementById("nuit-count").textContent = nuitCount;
    document.getElementById("24h-count").textContent = count24h;
    document.getElementById("displayed-count").textContent = displayedCount;
}

// Localiser l'utilisateur
function locateUser() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                const pos = {
                    lat: position.coords.latitude,
                    lng: position.coords.longitude
                };

                // Supprimer l'ancien marqueur s'il existe
                if (userLocationMarker) {
                    userLocationMarker.setMap(null);
                }

                // Ajouter un nouveau marqueur pour la position de l'utilisateur
                userLocationMarker = new google.maps.Marker({
                    position: pos,
                    map: map,
                    title: "Votre position",
                    icon: {
                        url: "http://maps.google.com/mapfiles/ms/icons/blue-dot.png",
                        scaledSize: new google.maps.Size(40, 40)
                    },
                    animation: google.maps.Animation.BOUNCE
                });

                // Centrer la carte sur la position de l'utilisateur
                map.setCenter(pos);
                map.setZoom(14);

                // Arrêter l'animation après 2 secondes
                setTimeout(() => {
                    if (userLocationMarker) {
                        userLocationMarker.setAnimation(null);
                    }
                }, 2000);

                // Afficher une infobulle
                const infoWindow = new google.maps.InfoWindow({
                    content: `
                        <div style="padding: 15px; max-width: 300px;">
                            <h3 style="margin: 0 0 10px 0; color: #2c3e50;">
                                <i class="fas fa-location-arrow"></i> Votre position
                            </h3>
                            <p style="margin: 5px 0; color: #666;">
                                Latitude: ${pos.lat.toFixed(6)}<br>
                                Longitude: ${pos.lng.toFixed(6)}
                            </p>
                            <p style="margin: 5px 0; color: #666; font-size: 0.9rem;">
                                <i class="fas fa-info-circle"></i> Les pharmacies à proximité sont affichées sur la carte
                            </p>
                        </div>
                    `
                });

                infoWindow.open(map, userLocationMarker);

                // Fermer l'infobulle après 5 secondes
                setTimeout(() => {
                    infoWindow.close();
                }, 5000);

            },
            (error) => {
                let errorMessage = "Impossible d'obtenir votre position.";
                switch(error.code) {
                    case error.PERMISSION_DENIED:
                        errorMessage = "Permission de géolocalisation refusée.";
                        break;
                    case error.POSITION_UNAVAILABLE:
                        errorMessage = "Information de position indisponible.";
                        break;
                    case error.TIMEOUT:
                        errorMessage = "La requête de géolocalisation a expiré.";
                        break;
                }
                alert(errorMessage);
            },
            {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 0
            }
        );
    } else {
        alert("La géolocalisation n'est pas supportée par votre navigateur.");
    }
}

// Gérer les événements DOM
document.addEventListener('DOMContentLoaded', function() {
    // Recherche par gouvernorat
    document.getElementById('search-btn').addEventListener('click', function() {
        const selectedGovernorate = document.getElementById('governorate-select').value;
        const selectedHoraire = document.getElementById('horaire-select').value;

        if (!selectedGovernorate) {
            // Afficher toutes les pharmacies avec filtre d'horaire
            if (selectedHoraire) {
                let allPharmacies = [];
                Object.entries(pharmaciesTunisie).forEach(([gouvernorat, pharmaciesList]) => {
                    pharmaciesList.forEach(pharmacie => {
                        if (pharmacie.horaire === selectedHoraire) {
                            allPharmacies.push({
                                ...pharmacie,
                                gouvernorat: gouvernorat
                            });
                        }
                    });
                });

                clearMarkers();
                displayPharmacies(allPharmacies);
                updateTable(allPharmacies);
                document.getElementById('displayed-detail').textContent = `avec horaire ${selectedHoraire}`;
            } else {
                showAllPharmacies();
            }
        } else {
            showPharmaciesByGovernorate(selectedGovernorate, selectedHoraire);
        }

        document.getElementById('map-section').classList.add('active');
        document.getElementById('map-section').scrollIntoView({ behavior: 'smooth' });
    });

    // Recherche par nom de pharmacie
    document.getElementById('search-pharmacy').addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        if (!query) return;

        let filteredPharmacies = [];
        Object.entries(pharmaciesTunisie).forEach(([gouvernorat, pharmaciesList]) => {
            pharmaciesList.forEach(pharmacie => {
                if (pharmacie.name.toLowerCase().includes(query)) {
                    filteredPharmacies.push({
                        ...pharmacie,
                        gouvernorat: gouvernorat
                    });
                }
            });
        });

        if (filteredPharmacies.length > 0) {
            clearMarkers();
            displayPharmacies(filteredPharmacies);
            updateTable(filteredPharmacies);
        }
    });

    // Filtre d'horaire sur la carte
    document.getElementById('filter-horaire-map').addEventListener('change', function() {
        const horaireFilter = this.value;
        const selectedGovernorate = document.getElementById('governorate-select').value;

        if (selectedGovernorate) {
            showPharmaciesByGovernorate(selectedGovernorate, horaireFilter);
        } else if (horaireFilter) {
            let filteredPharmacies = [];
            Object.entries(pharmaciesTunisie).forEach(([gouvernorat, pharmaciesList]) => {
                pharmaciesList.forEach(pharmacie => {
                    if (pharmacie.horaire === horaireFilter) {
                        filteredPharmacies.push({
                            ...pharmacie,
                            gouvernorat: gouvernorat
                        });
                    }
                });
            });

            clearMarkers();
            displayPharmacies(filteredPharmacies);
            updateTable(filteredPharmacies);
        } else {
            showAllPharmacies();
        }
    });

    // Toutes les pharmacies
    document.getElementById('show-all-btn').addEventListener('click', function() {
        document.getElementById('governorate-select').value = '';
        document.getElementById('horaire-select').value = '';
        document.getElementById('filter-horaire-map').value = '';
        showAllPharmacies();
        document.getElementById('map-section').classList.add('active');
        document.getElementById('map-section').scrollIntoView({ behavior: 'smooth' });
    });

    // Localisation
    document.getElementById('locate-btn').addEventListener('click', function() {
        locateUser();
        document.getElementById('map-section').classList.add('active');
        document.getElementById('map-section').scrollIntoView({ behavior: 'smooth' });
    });

    // Zoom in
    document.getElementById('zoom-in-btn').addEventListener('click', function() {
        if (map) {
            currentZoom = Math.min(currentZoom + 1, 20);
            map.setZoom(currentZoom);
        }
    });

    // Zoom out
    document.getElementById('zoom-out-btn').addEventListener('click', function() {
        if (map) {
            currentZoom = Math.max(currentZoom - 1, 1);
            map.setZoom(currentZoom);
        }
    });

    // Réinitialiser
    document.getElementById('reset-btn').addEventListener('click', function() {
        document.getElementById('search-pharmacy').value = '';
        document.getElementById('filter-horaire-map').value = '';
        showAllPharmacies();
    });

    // Afficher/Cacher
    document.getElementById('toggle-pharmacies-btn').addEventListener('click', function() {
        const mapSection = document.getElementById('map-section');
        if (mapSection.classList.contains('active')) {
            mapSection.classList.remove('active');
            this.innerHTML = '<i class="fas fa-map-marker-alt"></i> Afficher la carte';
        } else {
            mapSection.classList.add('active');
            this.innerHTML = '<i class="fas fa-map-marker-alt"></i> Cacher la carte';
            showAllPharmacies();
            mapSection.scrollIntoView({ behavior: 'smooth' });
        }
    });

    // Fermer la carte
    document.getElementById('close-map').addEventListener('click', function() {
        document.getElementById('map-section').classList.remove('active');
        document.getElementById('toggle-pharmacies-btn').innerHTML = '<i class="fas fa-map-marker-alt"></i> Afficher la carte';
    });

    // Recherche avec Entrée dans le champ de recherche
    document.getElementById('search-pharmacy').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            this.dispatchEvent(new Event('input'));
        }
    });
});

