{% extends 'base.html.twig' %}

{% block title %}Liste des Animaux{% endblock %}

{% block body %}
    <section class="main-content" style="padding-top: 30px; padding-bottom: 30px;">
        <div class="container">
            <h2 class="mb-4 text-center">Liste des Animaux</h2>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-primary">
                    <tr>
                        <th>
                            <a href="{{ path('lists_animaux', {
                                sort: 'nom',
                                order: sort == 'nom' and order == 'ASC' ? 'DESC' : 'ASC'
                            }) }}">
                                Nom
                                {% if sort == 'nom' %}
                                    {% if order == 'ASC' %} ▲ {% else %} ▼ {% endif %}
                                {% endif %}
                            </a>
                        </th>

                        <th>
                            <a href="{{ path('lists_animaux', {
                                sort: 'typeAnimal',
                                order: sort == 'typeAnimal' and order == 'ASC' ? 'DESC' : 'ASC'
                            }) }}">
                                Type
                                {% if sort == 'typeAnimal' %}
                                    {% if order == 'ASC' %} ▲ {% else %} ▼ {% endif %}
                                {% endif %}
                            </a>
                        </th>

                        <th>Sexe</th>

                        <th>
                            <a href="{{ path('lists_animaux', {
                                sort: 'poids',
                                order: sort == 'poids' and order == 'ASC' ? 'DESC' : 'ASC'
                            }) }}">
                                Poids (kg)
                                {% if sort == 'poids' %}
                                    {% if order == 'ASC' %} ▲ {% else %} ▼ {% endif %}
                                {% endif %}
                            </a>
                        </th>

                        <th>
                            <a href="{{ path('lists_animaux', {
                                sort: 'couleur',
                                order: sort == 'couleur' and order == 'ASC' ? 'DESC' : 'ASC'
                            }) }}">
                                Couleur
                                {% if sort == 'couleur' %}
                                    {% if order == 'ASC' %} ▲ {% else %} ▼ {% endif %}
                                {% endif %}
                            </a>
                        </th>

                        <th>
                            <a href="{{ path('lists_animaux', {
                                sort: 'dateNaissance',
                                order: sort == 'dateNaissance' and order == 'ASC' ? 'DESC' : 'ASC'
                            }) }}">
                                Date Naissance
                                {% if sort == 'dateNaissance' %}
                                    {% if order == 'ASC' %} ▲ {% else %} ▼ {% endif %}
                                {% endif %}
                            </a>
                        </th>

                        <th>
                            <a href="{{ path('lists_animaux', {
                                sort: 'dateEnregistrement',
                                order: sort == 'dateEnregistrement' and order == 'ASC' ? 'DESC' : 'ASC'
                            }) }}">
                                Date Enregistrement
                                {% if sort == 'dateEnregistrement' %}
                                    {% if order == 'ASC' %} ▲ {% else %} ▼ {% endif %}
                                {% endif %}
                            </a>
                        </th>

                        <th>Actions</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for animal in tabAnimaux %}
                        <tr class="align-middle">
                            <td>{{ animal.nom }}</td>
                            <td>
                                <span class="badge
                                    {% if animal.typeAnimal == 'Chien' %}bg-primary
                                    {% elseif animal.typeAnimal == 'Chat' %}bg-warning text-dark
                                    {% else %}bg-info text-dark{% endif %}">
                                    {{ animal.typeAnimal }}
                                </span>
                            </td>
                            <td>
                                <span class="badge {% if animal.sexe == 'Mâle' %}bg-info text-dark{% else %}bg-danger{% endif %}">
                                    {{ animal.sexe }}
                                </span>
                            </td>
                            <td>{{ animal.poids }}</td>
                            <td>{{ animal.couleur }}</td>
                            <td>{{ animal.dateNaissance ? animal.dateNaissance|date('d/m/Y') : '' }}</td>
                            <td>{{ animal.dateEnregistrement ? animal.dateEnregistrement|date('d/m/Y') : '' }}</td>

                            <td class="d-flex justify-content-center gap-2 flex-wrap">
                                <a href="{{ path('update_animal', {'id': animal.idAnimal}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit me-1"></i> Modifier
                                </a>
                                <a href="{{ path('remove_animal', {'id_animal': animal.idAnimal}) }}" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash-alt me-1"></i> Supprimer
                                </a>
                                <a href="{{ path('add_dossier_for_animal', {'animalId': animal.idAnimal}) }}" class="btn btn-success btn-sm">
                                    <i class="fas fa-notes-medical me-1"></i> Ajouter Dossier
                                </a>
                                {% if animal.dossierAnimal %}
                                    <a href="{{ path('show_dossier', {'id': animal.dossierAnimal.idDossier}) }}" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye me-1"></i> Voir
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center">Aucun animal trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-4 text-center">
                <a href="{{ path('addForm_animal') }}" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus-circle me-2"></i> Ajouter un nouvel animal
                </a>
            </div>
        </div>
    </section>

    <style>
        table.table-hover tbody tr:hover {
            background-color: #f0f8ff;
            transition: background-color 0.2s;
        }

        .badge {
            padding: 0.4em 0.6em;
            font-size: 0.9em;
        }

        td .btn {
            display: flex;
            align-items: center;
        }

        th a {
            color: #000;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            width: 100%;
            padding: 8px 0;
        }

        th a:hover {
            text-decoration: underline;
            color: #003366;
        }
    </style>

{% endblock %}
