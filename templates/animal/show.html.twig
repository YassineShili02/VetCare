{% extends 'base.html.twig' %}

{% block title %}{{ animal.nom }} - Détails{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                {# En-tête avec boutons d'action #}
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>
                        <i class="fas fa-paw me-2 text-primary"></i>
                        Fiche de {{ animal.nom }}
                    </h2>
                    <div class="btn-group">
                        <a href="{{ path('lists_animaux') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Retour
                        </a>
                        <a href="{{ path('update_animal', {'id': animal.idAnimal}) }}" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i> Modifier
                        </a>
                        <a href="{{ path('remove_animal', {'id_animal': animal.idAnimal}) }}"
                           class="btn btn-danger"
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer {{ animal.nom }} ?')">
                            <i class="fas fa-trash me-1"></i> Supprimer
                        </a>
                    </div>
                </div>

                {# Card principale #}
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            Informations générales
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            {# Colonne gauche #}
                            <div class="col-md-6">
                                <div class="info-group mb-4">
                                    <h5 class="text-muted mb-3">
                                        <i class="fas fa-id-card me-2"></i>Identité
                                    </h5>
                                    <table class="table table-borderless">
                                        <tr>
                                            <td class="fw-bold" style="width: 40%;">Nom :</td>
                                            <td>{{ animal.nom }}</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Type :</td>
                                            <td>
                                            <span class="badge
                                                {% if animal.typeAnimal == 'Chien' %}bg-primary
                                                {% elseif animal.typeAnimal == 'Chat' %}bg-warning text-dark
                                                {% else %}bg-info{% endif %}">
                                                {{ animal.typeAnimal }}
                                            </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Sexe :</td>
                                            <td>
                                            <span class="badge {% if animal.sexe == 'M' %}bg-info{% else %}bg-danger{% endif %}">
                                                {{ animal.sexe == 'M' ? 'Mâle' : 'Femelle' }}
                                            </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Couleur :</td>
                                            <td>{{ animal.couleur }}</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            {# Colonne droite #}
                            <div class="col-md-6">
                                <div class="info-group mb-4">
                                    <h5 class="text-muted mb-3">
                                        <i class="fas fa-weight me-2"></i>Caractéristiques
                                    </h5>
                                    <table class="table table-borderless">
                                        <tr>
                                            <td class="fw-bold" style="width: 50%;">Poids :</td>
                                            <td>{{ animal.poids }} kg</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Date de naissance :</td>
                                            <td>{{ animal.dateNaissance|date('d/m/Y') }}</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Âge approximatif :</td>
                                            <td>
                                                {% set age = date('now').diff(animal.dateNaissance).y %}
                                                {{ age }} an{{ age > 1 ? 's' : '' }}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Date d'enregistrement :</td>
                                            <td>{{ animal.dateEnregistrement|date('d/m/Y à H:i') }}</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        {# Informations du propriétaire #}
                        {% if animal.owner %}
                            <div class="info-group mb-4">
                                <h5 class="text-muted mb-3">
                                    <i class="fas fa-user me-2"></i>Propriétaire
                                </h5>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-2 text-center">
                                                <div class="avatar bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                                                     style="width: 60px; height: 60px; font-size: 24px;">
                                                    {{ animal.owner.initials }}
                                                </div>
                                            </div>
                                            <div class="col-md-10">
                                                <h6 class="mb-1">{{ animal.owner.fullName }}</h6>
                                                <p class="mb-1 text-muted">
                                                    <i class="fas fa-envelope me-2"></i>{{ animal.owner.email }}
                                                </p>
                                                {% if animal.owner.phone %}
                                                    <p class="mb-0 text-muted">
                                                        <i class="fas fa-phone me-2"></i>{{ animal.owner.phone }}
                                                    </p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <hr class="my-4">

                        {# Section Dossier Médical #}
                        <div class="info-group">
                            <h5 class="text-muted mb-3">
                                <i class="fas fa-notes-medical me-2"></i>Dossier Médical
                            </h5>

                            {% if animal.dossierAnimal %}
                                <div class="alert alert-success">
                                    <i class="fas fa-check-circle me-2"></i>
                                    Un dossier médical existe pour cet animal.
                                    <a href="{{ path('show_dossier', {'id': animal.dossierAnimal.idDossier}) }}"
                                       class="btn btn-sm btn-success ms-3">
                                        <i class="fas fa-eye me-1"></i> Consulter le dossier
                                    </a>
                                </div>
                            {% else %}
                                {% if is_granted('ROLE_VETERINAIRE') or is_granted('ROLE_ADMIN') %}
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        Aucun dossier médical pour cet animal.
                                        <a href="{{ path('add_dossier_for_animal', {'animalId': animal.idAnimal}) }}"
                                           class="btn btn-sm btn-warning ms-3">
                                            <i class="fas fa-plus me-1"></i> Créer un dossier
                                        </a>
                                    </div>
                                {% else %}
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        Aucun dossier médical disponible pour cet animal.
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <style>
        .info-group h5 {
            border-bottom: 2px solid #e9ecef;
            padding-bottom: 10px;
        }

        .table-borderless td {
            padding: 8px 0;
        }

        .avatar {
            font-weight: bold;
        }
    </style>
{% endblock %}
