{% extends 'base.html.twig' %}

{% block title %}Gestion des Animaux{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="text-center">
            <h2 class="mb-4">Bienvenue à VetCare</h2>
            <p class="mb-5">Choisissez une action :</p>

            <div class="row g-4 justify-content-center">
                <!-- Carte : Liste des Animaux -->
                <div class="col-md-5">
                    <div class="card shadow-sm">
                        <!-- Image en haut de la carte -->
                        <img src="{{ asset('front/img/gallery/gallery2.png') }}" class="card-img-top" alt="Liste des Animaux">
                        <div class="card-body">
                            <h5 class="card-title">Liste des Animaux</h5>
                            <p class="card-text">Consultez tous les animaux enregistrés.</p>
                            <a href="{{ path('lists_animaux') }}" class="btn btn-primary">Voir la liste</a>
                        </div>
                    </div>
                </div>

                <!-- Carte : Ajouter un Animal -->
                <div class="col-md-5">
                    <div class="card shadow-sm">
                        <!-- Image en haut de la carte -->
                        <img src="{{ asset('front/img/gallery/gallery3.png') }}" class="card-img-top" alt="Ajouter un Animal">
                        <div class="card-body">
                            <h5 class="card-title">Ajouter un Animal</h5>
                            <p class="card-text">Enregistrez un nouvel animal dans le système.</p>
                            <a href="{{ path('addForm_animal') }}" class="btn btn-success">Ajouter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
