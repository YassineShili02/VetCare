/* Styles pour la galerie d'avatars */
.avatar-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
}

.avatar-item {
    cursor: pointer;
    text-align: center;
    padding: 10px;
    border-radius: 8px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    width: 100px;
}

.avatar-item:hover {
    background-color: #f8f9fa;
    border-color: #dee2e6;
    transform: translateY(-2px);
}

.avatar-item.selected {
    background-color: #e8f4fc;
    border-color: #3498db;
    box-shadow: 0 0 10px rgba(52, 152, 219, 0.3);
}

.avatar-default {
    border: 2px solid #dee2e6;
    transition: all 0.3s ease;
}

.avatar-item.selected .avatar-default {
    border-color: #3498db;
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.3);
    transform: scale(1.1);
}

.avatar-label {
    display: block;
    margin-top: 5px;
    font-size: 12px;
    color: #6c757d;
}
/* Dans la section <style> de votre template */
.role-selection {
    background-color: #f8f9fa;
    padding: 15px;
    border-radius: 8px;
    border: 1px solid #dee2e6;
}

.role-radio {
    margin-right: 10px;
}

.role-label {
    font-weight: 500;
    color: #495057;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: 6px;
    transition: all 0.3s ease;
    display: block;
    margin-left: 30px;
}

.role-label:hover {
    background-color: #e9ecef;
}

.form-check-input:checked + .role-label {
    background-color: #e7f1ff;
    color: #0d6efd;
    font-weight: bold;
}

/* Icônes pour les rôles */
.role-label[for*="ROLE_USER"]::before {
    content: "👤 ";
    margin-right: 8px;
}

.role-label[for*="ROLE_VET"]::before {
    content: "🐾 ";
    margin-right: 8px;
}

.role-label[for*="ROLE_ADMIN"]::before {
    content: "⚙️ ";
    margin-right: 8px;
}

/* Onglets */
.nav-tabs .nav-link {
    color: #495057;
    border: none;
    padding: 10px 20px;
}

.nav-tabs .nav-link.active {
    color: #3498db;
    background-color = transparent;
    border-bottom: 3px solid #3498db;
    font-weight: bold;
}

/* Force du mot de passe */
.password-strength {
    height: 5px;
    border-radius: 3px;
    margin-top: 5px;
    transition: all 0.3s ease;
}

.strength-weak { background-color: #dc3545; width: 25%; }
.strength-medium { background-color: #ffc107; width: 50%; }
.strength-strong { background-color: #28a745; width: 75%; }
.strength-very-strong { background-color: #20c997; width: 100%; }

/* Alertes personnalisées */
.custom-alert {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    min-width: 300px;
    animation: slideInRight 0.3s ease;
}

@keyframes slideInRight {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* Vidéo caméra */
#camera-stream {
    background: #343a40;
    border-radius: 6px;
    max-height: 400px;
}

/* Boutons */
.btn-group .btn {
    margin: 0 2px;
}

/* Animation pour la sélection */
@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}

.avatar-item.selected {
    animation: pulse 0.5s ease;
}
</style>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const userId = document.getElementById('user-id').value;
    const userInitials = document.getElementById('user-initials').value;
    const csrfTokenPassword = document.getElementById('csrf-token-password').value;
    const csrfTokenUpdatePhoto = document.getElementById('csrf-token-update-photo').value;
    const csrfTokenResetPhoto = document.getElementById('csrf-token-reset-photo').value;
    
    let selectedAvatarData = null;
    let selectedPhotoFile = null;
    let cameraStream = null;
    let currentPhotoData = null;
    let isFrontCamera = true;

    // ============================================
    // 1. GESTION DE LA GALERIE D'AVATARS
    // ============================================

    // Sélection d'un avatar depuis la galerie
    window.selectAvatar = function(type, index) {
        console.log(`Avatar sélectionné: ${type}-${index}`);
        
        // Retirer la sélection précédente
        document.querySelectorAll('.avatar-item').forEach(item => {
            item.classList.remove('selected');
        });
        
        // Ajouter la sélection à l'élément cliqué
        event.currentTarget.classList.add('selected');
        
        // Créer un avatar personnalisé avec canvas
        const canvas = document.createElement('canvas');
        canvas.width = 150;
        canvas.height = 150;
        const ctx = canvas.getContext('2d');
        
        // Définir la couleur basée sur le type et l'index
        let color;
        if (type === 'user') {
            const userColors = ['#3498db', '#2ecc71', '#e74c3c', '#f39c12', '#9b59b6'];
            color = userColors[index - 1] || '#3498db';
        } else if (type === 'vet') {
            const vetColors = ['#16a085', '#27ae60', '#d35400', '#c0392b', '#8e44ad'];
            color = vetColors[index - 1] || '#16a085';
        } else {
            const adminColors = ['#2c3e50', '#34495e', '#7f8c8d', '#95a5a6', '#bdc3c7'];
            color = adminColors[index - 1] || '#2c3e50';
        }
        
        // Dessiner le cercle de fond
        ctx.beginPath();
        ctx.arc(75, 75, 70, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
        
        // Dessiner les initiales
        ctx.fillStyle = 'white';
        ctx.font = 'bold 40px Arial';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(userInitials, 75, 75);
        
        // Ajouter un petit symbole selon le type
        ctx.font = 'bold 20px Arial';
        if (type === 'vet') {
            ctx.fillText('🐾', 75, 110);
        } else if (type === 'admin') {
            ctx.fillText('⚙️', 75, 110);
        }
        
        // Préparer les données
        selectedAvatarData = {
            type: type,
            index: index,
            color: color,
            initials: userInitials
        };
        
        // Mettre à jour la prévisualisation
        const previewUrl = canvas.toDataURL('image/png');
        document.getElementById('photo-preview').src = previewUrl;
        document.getElementById('photo-preview-section').style.display = 'block';
        
        selectedPhotoFile = null;
        currentPhotoData = previewUrl;
        
        // Fermer le modal après un délai
        setTimeout(() => {
            const modal = bootstrap.Modal.getInstance(document.getElementById('avatarGalleryModal'));
            if (modal) modal.hide();
        }, 500);
    };

    // ============================================
    // 2. GESTION DE L'UPLOAD DE FICHIER
    // ============================================

    window.handleFileSelect = function(file) {
        if (!file || !file.type.match('image.*')) {
            showAlert('error', 'Veuillez sélectionner une image valide (JPG, PNG, GIF, WebP)');
            return;
        }
        
        if (file.size > 5 * 1024 * 1024) {
            showAlert('error', 'L\'image ne doit pas dépasser 5MB');
            return;
        }
        
        selectedPhotoFile = file;
        selectedAvatarData = null;
        
        // Afficher la prévisualisation
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('photo-preview').src = e.target.result;
            document.getElementById('photo-preview-section').style.display = 'block';
            currentPhotoData = e.target.result;
        };
        reader.readAsDataURL(file);
    };

    // ============================================
    // 3. GESTION DE LA CAMÉRA
    // ============================================

    // Ouvrir la caméra
    const cameraModal = document.getElementById('cameraModal');
    if (cameraModal) {
        cameraModal.addEventListener('shown.bs.modal', function() {
            startCamera();
        });
        
        cameraModal.addEventListener('hidden.bs.modal', function() {
            stopCamera();
        });
    }

    function startCamera() {
        navigator.mediaDevices.getUserMedia({ 
            video: { 
                facingMode: isFrontCamera ? 'user' : 'environment',
                width: { ideal: 640 },
                height: { ideal: 480 }
            },
            audio: false 
        })
        .then(function(stream) {
            cameraStream = stream;
            const videoElement = document.getElementById('camera-stream');
            if (videoElement) {
                videoElement.srcObject = stream;
            }
        })
        .catch(function(error) {
            console.error('Erreur caméra:', error);
            showAlert('error', 'Impossible d\'accéder à la caméra. Vérifiez les permissions.');
        });
    }

    function stopCamera() {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
        }
    }

    window.switchCamera = function() {
        isFrontCamera = !isFrontCamera;
        stopCamera();
        startCamera();
    };

    window.capturePhoto = function() {
        const video = document.getElementById('camera-stream');
        const canvas = document.getElementById('photo-canvas');
        const context = canvas.getContext('2d');
        
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        context.drawImage(video, 0, 0, canvas.width, canvas.height);
        
        // Convertir en base64
        const photoData = canvas.toDataURL('image/jpeg');
        selectedPhotoFile = null;
        selectedAvatarData = null;
        
        // Afficher la prévisualisation
        document.getElementById('photo-preview').src = photoData;
        document.getElementById('photo-preview-section').style.display = 'block';
        currentPhotoData = photoData;
        
        // Fermer le modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('cameraModal'));
        if (modal) modal.hide();
        
        showAlert('success', 'Photo capturée avec succès!');
    };

    // ============================================
    // 4. SAUVEGARDE DE LA PHOTO (CORRIGÉE POUR CSRF)
    // ============================================

    window.saveProfilePhoto = async function() {
        if (!currentPhotoData) {
            showAlert('error', 'Aucune photo sélectionnée');
            return;
        }
        
        try {
            // Afficher un indicateur de chargement
            const saveBtn = document.querySelector('#photo-preview-section .btn-success');
            const originalText = saveBtn.innerHTML;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
            saveBtn.disabled = true;
            
            let photoDataToSend;
            
            if (selectedAvatarData) {
                // Cas 1: Avatar généré
                photoDataToSend = {
                    avatar_type: selectedAvatarData.type,
                    avatar_index: selectedAvatarData.index,
                    avatar_color: selectedAvatarData.color,
                    avatar_initials: selectedAvatarData.initials,
                    photo_data: currentPhotoData,
                    _token: csrfTokenUpdatePhoto // Token CSRF correct
                };
            } else {
                // Cas 2: Photo uploadée ou de la caméra
                photoDataToSend = {
                    photo_data: currentPhotoData,
                    file_name: selectedPhotoFile ? selectedPhotoFile.name : 'camera-photo.jpg',
                    file_type: selectedPhotoFile ? selectedPhotoFile.type : 'image/jpeg',
                    _token: csrfTokenUpdatePhoto // Token CSRF correct
                };
            }
            
            console.log('Envoi des données avec token:', csrfTokenUpdatePhoto);
            
            // Envoyer la requête
            const response = await fetch(`/user/${userId}/update-photo-ajax`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(photoDataToSend)
            });
            
            const data = await response.json();
            console.log('Réponse reçue:', data);
            
            if (data.success) {
                showAlert('success', data.message || 'Photo mise à jour avec succès!');
                
                // Mettre à jour l'image principale
                if (data.photo_url) {
                    document.getElementById('current-profile-avatar').src = data.photo_url;
                } else {
                    document.getElementById('current-profile-avatar').src = currentPhotoData;
                }
                
                // Masquer la prévisualisation
                cancelPhotoChange();
                
                // Rafraîchir après un délai
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            } else {
                throw new Error(data.message || 'Erreur lors de l\'enregistrement');
            }
            
        } catch (error) {
            console.error('Erreur:', error);
            showAlert('error', error.message || 'Erreur lors de l\'enregistrement');
        } finally {
            // Restaurer le bouton
            const saveBtn = document.querySelector('#photo-preview-section .btn-success');
            if (saveBtn) {
                saveBtn.innerHTML = '<i class="fas fa-check me-1"></i> Confirmer';
                saveBtn.disabled = false;
            }
        }
    };

    window.cancelPhotoChange = function() {
        document.getElementById('photo-preview-section').style.display = 'none';
        selectedAvatarData = null;
        selectedPhotoFile = null;
        currentPhotoData = null;
        document.getElementById('photo-preview').src = '';
        document.getElementById('file-input').value = '';
        
        // Désélectionner tous les avatars
        document.querySelectorAll('.avatar-item').forEach(item => {
            item.classList.remove('selected');
        });
    };

    window.resetToDefaultAvatar = async function() {
        if (!confirm('Voulez-vous vraiment réinitialiser votre photo de profil ?')) {
            return;
        }
        
        try {
            const response = await fetch(`/user/${userId}/reset-photo-ajax`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    _token: csrfTokenResetPhoto // Token CSRF correct
                })
            });
            
            const data = await response.json();
            
            if (data.success) {
                showAlert('success', data.message || 'Photo réinitialisée avec succès!');
                document.getElementById('current-profile-avatar').src = data.default_photo || '/front/images/default-avatar.png';
                
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            } else {
                throw new Error(data.message || 'Erreur lors de la réinitialisation');
            }
            
        } catch (error) {
            console.error('Erreur:', error);
            showAlert('error', error.message || 'Erreur lors de la réinitialisation');
        }
    };

    // ============================================
    // 5. CHANGEMENT DE MOT DE PASSE
    // ============================================

    // Affichage/masquage des mots de passe
    document.getElementById('toggle-current-password')?.addEventListener('click', function() {
        togglePasswordVisibility('current-password', this);
    });

    document.getElementById('toggle-new-password')?.addEventListener('click', function() {
        togglePasswordVisibility('new-password', this);
    });

    document.getElementById('toggle-confirm-password')?.addEventListener('click', function() {
        togglePasswordVisibility('confirm-password', this);
    });

    function togglePasswordVisibility(inputId, button) {
        const input = document.getElementById(inputId);
        const icon = button.querySelector('i');
        
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Validation en temps réel
    document.getElementById('new-password')?.addEventListener('input', function() {
        checkPasswordStrength(this.value);
        validatePasswordMatch();
    });

    document.getElementById('confirm-password')?.addEventListener('input', validatePasswordMatch);

    function checkPasswordStrength(password) {
        let strength = 0;
        
        if (password.length >= 6) strength++;
        if (/[a-z]/.test(password)) strength++;
        if (/[A-Z]/.test(password)) strength++;
        if (/[0-9]/.test(password)) strength++;
        if (/[^A-Za-z0-9]/.test(password)) strength++;
        
        const strengthBar = document.getElementById('password-strength-bar');
        if (!strengthBar) return;
        
        strengthBar.className = 'password-strength';
        if (password.length === 0) {
            strengthBar.style.display = 'none';
        } else {
            strengthBar.style.display = 'block';
            if (strength <= 2) {
                strengthBar.className += ' strength-weak';
            } else if (strength === 3) {
                strengthBar.className += ' strength-medium';
            } else if (strength === 4) {
                strengthBar.className += ' strength-strong';
            } else {
                strengthBar.className += ' strength-very-strong';
            }
        }
    }

    function validatePasswordMatch() {
        const newPassword = document.getElementById('new-password')?.value || '';
        const confirmPassword = document.getElementById('confirm-password')?.value || '';
        const confirmInput = document.getElementById('confirm-password');
        const errorDiv = document.getElementById('password-match-error');
        
        if (!confirmInput) return;
        
        if (confirmPassword && newPassword !== confirmPassword) {
            confirmInput.classList.add('is-invalid');
            if (errorDiv) errorDiv.style.display = 'block';
        } else if (confirmPassword) {
            confirmInput.classList.remove('is-invalid');
            confirmInput.classList.add('is-valid');
            if (errorDiv) errorDiv.style.display = 'none';
        } else {
            confirmInput.classList.remove('is-invalid', 'is-valid');
            if (errorDiv) errorDiv.style.display = 'none';
        }
    }

    // Soumission du formulaire
    document.getElementById('change-password-form')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        console.log("Formulaire de changement de mot de passe soumis");
        
        const currentPassword = document.getElementById('current-password')?.value || '';
        const newPassword = document.getElementById('new-password')?.value || '';
        const confirmPassword = document.getElementById('confirm-password')?.value || '';
        
        // Validation simple
        if (!currentPassword) {
            showAlert('error', 'Veuillez entrer votre mot de passe actuel');
            return;
        }
        
        if (!newPassword || newPassword.length < 6) {
            showAlert('error', 'Le nouveau mot de passe doit contenir au moins 6 caractères');
            return;
        }
        
        if (newPassword !== confirmPassword) {
            showAlert('error', 'Les mots de passe ne correspondent pas');
            return;
        }
        
        // Préparer les données JSON
        const formData = {
            current_password: currentPassword,
            new_password: newPassword,
            confirm_password: confirmPassword,
            _token: csrfTokenPassword // Utiliser le bon token CSRF
        };
        
        console.log("Données à envoyer:", formData);
        
        // Afficher la progression
        const progressBar = document.getElementById('password-progress');
        const progressBarInner = progressBar?.querySelector('.progress-bar');
        const submitBtn = document.getElementById('change-password-btn');
        const originalBtnText = submitBtn?.innerHTML || '';
        
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Changement en cours...';
        }
        
        if (progressBar) {
            progressBar.style.display = 'block';
        }
        if (progressBarInner) {
            progressBarInner.style.width = '30%';
        }
        
        try {
            // Envoyer la requête avec JSON
            const response = await fetch('/user/' + userId + '/change-password-ajax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(formData)
            });
            
            console.log("Réponse reçue, status:", response.status);
            
            if (progressBarInner) {
                progressBarInner.style.width = '70%';
            }
            
            // Vérifier si c'est du JSON
            const contentType = response.headers.get("content-type");
            let data;
            
            if (contentType && contentType.includes("application/json")) {
                data = await response.json();
            } else {
                const text = await response.text();
                console.error("Réponse non-JSON:", text);
                throw new Error("Le serveur a retourné une réponse invalide");
            }
            
            console.log("Données JSON reçues:", data);
            
            if (data.success) {
                if (progressBarInner) {
                    progressBarInner.style.width = '100%';
                }
                
                showAlert('success', data.message || 'Mot de passe changé avec succès!');
                
                // Réinitialiser le formulaire
                this.reset();
                const strengthBar = document.getElementById('password-strength-bar');
                if (strengthBar) {
                    strengthBar.style.display = 'none';
                }
                const confirmInput = document.getElementById('confirm-password');
                if (confirmInput) {
                    confirmInput.classList.remove('is-valid');
                }
                
                // Redirection après succès
                setTimeout(() => {
                    if (data.redirect_url) {
                        window.location.href = data.redirect_url;
                    } else {
                        window.location.reload();
                    }
                }, 2000);
                
            } else {
                throw new Error(data.message || 'Erreur lors du changement de mot de passe');
            }
            
        } catch (error) {
            console.error('Erreur:', error);
            showAlert('error', error.message || 'Erreur lors du changement de mot de passe');
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
            }
            if (progressBar) {
                setTimeout(() => {
                    progressBar.style.display = 'none';
                    if (progressBarInner) {
                        progressBarInner.style.width = '0%';
                    }
                }, 1000);
            }
        }
    });

    // ============================================
    // 6. FONCTIONS UTILITAIRES
    // ============================================

    function showAlert(type, message) {
        // Supprimer les anciennes alertes
        const oldAlerts = document.querySelectorAll('.custom-alert');
        oldAlerts.forEach(alert => alert.remove());
        
        // Créer la nouvelle alerte
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} custom-alert alert-dismissible fade show`;
        alertDiv.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        
        const icon = type === 'success' ? 'fa-check-circle' :
                    type === 'error' ? 'fa-exclamation-triangle' :
                    type === 'info' ? 'fa-info-circle' : 'fa-exclamation-circle';
        
        alertDiv.innerHTML = `
            <i class="fas ${icon}"></i> 
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(alertDiv);
        
        // Supprimer après 5 secondes
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.parentNode.removeChild(alertDiv);
            }
        }, 5000);
    }
});
</script>
