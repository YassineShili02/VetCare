{% extends 'base.html.twig' %}

{% block title %}Détail Utilisateur - {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="fas fa-user"></i> {{ user.firstName }} {{ user.lastName }}
                    </h2>
                    <div class="btn-group">
                        {# Bouton modifier - visible si l'utilisateur est le propriétaire ou ADMIN #}
                        {% if app.user.id == user.id or is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                        {% endif %}
                        <a href="{{ path('app_user_index') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="border-bottom pb-2">
                            <i class="fas fa-id-card"></i> Informations Personnelles
                        </h5>
                        <div class="mb-3">
                            <strong>Email:</strong>
                            <div class="text-muted">{{ user.email }}</div>
                        </div>
                        <div class="mb-3">
                            <strong>Téléphone:</strong>
                            <div class="text-muted">{{ user.phone ?? 'Non renseigné' }}</div>
                        </div>
                        <div class="mb-3">
                            <strong>Adresse:</strong>
                            <div class="text-muted">{{ user.address ?? 'Non renseignée' }}</div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <h5 class="border-bottom pb-2">
                            <i class="fas fa-cog"></i> Informations Système
                        </h5>
                        <div class="mb-3">
                            <strong>Rôles:</strong>
                            <div>
                                {% for role in user.roles %}
                                    <span class="badge bg-primary me-1">{{ role }}</span>
                                {% else %}
                                    <span class="text-muted">Aucun rôle défini</span>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="mb-3">
                            <strong>Créé le:</strong>
                            <div class="text-muted">{{ user.createdAt|date('d/m/Y à H:i') }}</div>
                        </div>
                        <div class="mb-3">
                            <strong>Modifié le:</strong>
                            <div class="text-muted">
                                {{ user.updatedAt ? user.updatedAt|date('d/m/Y à H:i') : 'Jamais modifié' }}
                            </div>
                        </div>
                        <div class="mb-3">
                            <strong>ID Utilisateur:</strong>
                            <div class="text-muted">#{{ user.id }}</div>
                        </div>
                    </div>
                </div>

                {# Section Animaux - Temporairement désactivée #}
                <div class="mt-4 pt-3 border-top">
                    <h5><i class="fas fa-paw"></i> Animaux</h5>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> 
                        Section animaux en cours de développement.
                    </div>
                </div>

                {# Actions #}
                <div class="mt-4 pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
                                <i class="fas fa-list"></i> Liste des utilisateurs
                            </a>
                        </div>
                        <div class="btn-group">
                            {# Bouton changer mot de passe - visible si l'utilisateur est le propriétaire ou ADMIN #}
                            {% if app.user.id == user.id or is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_user_change_password', {'id': user.id}) }}" class="btn btn-info">
                                    <i class="fas fa-key"></i> Changer mot de passe
                                </a>
                            {% endif %}
                            
                            {# Bouton modifier - visible si l'utilisateur est le propriétaire ou ADMIN #}
                            {% if app.user.id == user.id or is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning">
                                    <i class="fas fa-edit"></i> Modifier profil
                                </a>
                            {% endif %}
                            
                            {# Bouton supprimer - visible seulement pour les ADMIN et pas sur son propre profil #}
                            {% if is_granted('ROLE_ADMIN') and app.user.id != user.id %}
                                <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" 
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ? Cette action est irréversible.');"
                                      class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="btn btn-danger">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                    
                    {# Message d'information pour les non-ADMIN #}
                    {% if not is_granted('ROLE_ADMIN') and app.user.id == user.id %}
                        <div class="alert alert-info mt-3">
                            <i class="fas fa-info-circle"></i>
                            <strong>Information :</strong> Vous ne pouvez modifier que votre propre profil.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    border: 1px solid rgba(0, 0, 0, 0.125);
}
.card-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.125);
}
.border-bottom {
    border-bottom: 2px solid #dee2e6 !important;
}
.border-top {
    border-top: 2px solid #dee2e6 !important;
}
.btn-group .btn {
    margin-right: 0.25rem;
}
</style>
{% endblock %}