{% block title %}Profil de {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-4 mb-4">
        <!-- Carte pour la photo de profil -->
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-user-circle"></i> Photo de Profil</h5>
            </div>
            <div class="card-body text-center">
                <!-- Photo actuelle -->
                <div class="mb-3">
                    <img src="{{ user.profilePhoto ? asset(user.profilePhoto) : asset('front/images/default-avatar.png') }}" 
                         alt="Photo de profil" 
                         class="profile-avatar mb-3"
                         style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 5px solid #e9ecef;"
                         id="current-profile-avatar">
                    <div class="text-muted small">
                        Cliquez sur les options ci-dessous pour changer
                    </div>
                </div>

                <!-- Widget de changement de photo -->
                <div class="photo-upload-widget" data-user-id="{{ user.id }}">
                    <!-- Options de changement -->
                    <div class="photo-options">
                        <!-- Boutons d'options -->
                        <div class="d-grid gap-2">
                            <!-- Option 1: Galerie d'avatars -->
                            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#avatarGalleryModal">
                                <i class="fas fa-images me-2"></i> Choisir un avatar
                            </button>

                            <!-- Option 2: Upload depuis l'ordinateur -->
                            <button type="button" class="btn btn-outline-success" onclick="document.getElementById('file-input').click()">
                                <i class="fas fa-folder-open me-2"></i> Uploader une image
                            </button>
                            <input type="file" id="file-input" accept="image/*" style="display: none;" onchange="handleFileSelect(this.files[0])">

                            <!-- Option 3: Prendre une photo -->
                            <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#cameraModal">
                                <i class="fas fa-camera me-2"></i> Prendre une photo
                            </button>
                            
                            <!-- Option 4: Réinitialiser à l'avatar par défaut -->
                            {% if user.profilePhoto %}
                            <button type="button" class="btn btn-outline-danger" onclick="resetToDefaultAvatar()">
                                <i class="fas fa-undo me-2"></i> Réinitialiser
                            </button>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Prévisualisation et validation -->
                    <div class="photo-preview-section mt-4" id="photo-preview-section" style="display: none;">
                        <h6 class="mb-3">Nouvelle photo sélectionnée</h6>
                        <div class="preview-container text-center">
                            <img id="photo-preview" class="profile-image-preview mb-3" 
                                 style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 3px solid #28a745;">
                            <div class="preview-actions">
                                <button type="button" class="btn btn-success btn-sm me-2" onclick="saveProfilePhoto()">
                                    <i class="fas fa-check me-1"></i> Confirmer
                                </button>
                                <button type="button" class="btn btn-secondary btn-sm" onclick="cancelPhotoChange()">
                                    <i class="fas fa-times me-1"></i> Annuler
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Carte pour changer le mot de passe -->
        {% if app.user.id == user.id or is_granted('ROLE_ADMIN') %}
        <div class="card mt-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-key"></i> Changer le mot de passe</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    <i class="fas fa-info-circle"></i>
                    Pour des raisons de sécurité, vous serez déconnecté après le changement.
                </p>
                
                <form id="change-password-form" method="POST">
                    <div class="mb-3">
                        <label for="current-password" class="form-label">
                            <i class="fas fa-lock"></i> Mot de passe actuel
                        </label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="current-password" 
                                   name="current_password" placeholder="Entrez votre mot de passe actuel" required>
                            <button class="btn btn-outline-secondary" type="button" id="toggle-current-password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="new-password" class="form-label">
                            <i class="fas fa-key"></i> Nouveau mot de passe
                        </label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="new-password" 
                                   name="new_password" placeholder="Entrez votre nouveau mot de passe" required>
                            <button class="btn btn-outline-secondary" type="button" id="toggle-new-password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="form-text">
                            Minimum 6 caractères
                        </div>
                        <div id="password-strength-bar" class="password-strength" style="display: none;"></div>
                    </div>

                    <div class="mb-3">
                        <label for="confirm-password" class="form-label">
                            <i class="fas fa-check-circle"></i> Confirmer le mot de passe
                        </label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="confirm-password" 
                                   name="confirm_password" placeholder="Confirmez votre nouveau mot de passe" required>
                            <button class="btn btn-outline-secondary" type="button" id="toggle-confirm-password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="password-match-error" style="display: none;">
                            Les mots de passe ne correspondent pas
                        </div>
                    </div>

                    <!-- CSRF Token pour le changement de mot de passe -->
                    <input type="hidden" name="_token" id="csrf-token-password" value="{{ csrf_token('change_password_' ~ user.id) }}">
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" id="change-password-btn">
                            <i class="fas fa-sync-alt"></i> Changer le mot de passe
                        </button>
                    </div>
                    
                    <div class="progress mt-2" id="password-progress" style="display: none; height: 6px;">
                        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                    </div>
                </form>
            </div>
        </div>
        {% endif %}
    </div>

