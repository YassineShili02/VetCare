{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users"></i> Gestion des Utilisateurs</h1>
        <div class="btn-group">
            <a href="{{ path('app_user_new') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Nouvel Utilisateur
            </a>
<a href="{{ path('app_user_stats') }}" class="btn btn-info">
    <i class="fas fa-chart-bar"></i> Statistiques
</a>
            <a href="{{ path('app_user_export_csv') }}" class="btn btn-warning">
                <i class="fas fa-file-export"></i> Exporter CSV
            </a>
        </div>
    </div>

    <!-- Carte de statistiques -->
    {% if stats is defined %}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Utilisateurs</h6>
                            <h2 class="mb-0">{{ stats.total }}</h2>
                        </div>
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Clients</h6>
                            <h2 class="mb-0">{{ stats.Client }}</h2>
                        </div>
                        <i class="fas fa-user fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Vétérinaires</h6>
                            <h2 class="mb-0">{{ stats.Vétérinaire }}</h2>
                        </div>
                        <i class="fas fa-stethoscope fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Administrateurs</h6>
                            <h2 class="mb-0">{{ stats.Administrateur }}</h2>
                        </div>
                        <i class="fas fa-cogs fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Carte de filtres -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-filter"></i> Filtres et Tri
                {% if filters is defined and ((filters.search is defined and filters.search) or (filters.role is defined and filters.role)) %}
                <span class="badge bg-info ms-2">Filtres actifs</span>
                {% endif %}
            </h5>
        </div>
        <div class="card-body">
            <form method="GET" action="{{ path('app_user_filter') }}" class="row g-3" id="filter-form">
                <div class="col-md-4">
                    <label for="search" class="form-label">Recherche</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="search" name="search" 
                               placeholder="Nom, prénom, email, téléphone..." 
                               value="{{ filters.search is defined and filters.search is not null ? filters.search : '' }}">
                        <button class="btn btn-outline-secondary" type="button" id="clear-search">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                
                <div class="col-md-3">
                    <label for="role" class="form-label">Rôle</label>
                    <select class="form-select" id="role" name="role">
                        <option value="">Tous les rôles</option>
                        <option value="ROLE_USER" {% if filters.role is defined and filters.role == 'ROLE_USER' %}selected{% endif %}>Client</option>
                        <option value="ROLE_VET" {% if filters.role is defined and filters.role == 'ROLE_VET' %}selected{% endif %}>Vétérinaire</option>
                        <option value="ROLE_ADMIN" {% if filters.role is defined and filters.role == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur</option>
                    </select>
                </div>
                
                <div class="col-md-3">
                    <label for="sort_field" class="form-label">Trier par</label>
                    <select class="form-select" id="sort_field" name="sort_field">
                        <option value="u.lastName" {% if sort.field is defined and sort.field == 'u.lastName' %}selected{% endif %}>Nom</option>
                        <option value="u.firstName" {% if sort.field is defined and sort.field == 'u.firstName' %}selected{% endif %}>Prénom</option>
                        <option value="u.email" {% if sort.field is defined and sort.field == 'u.email' %}selected{% endif %}>Email</option>
                        <option value="u.createdAt" {% if sort.field is defined and sort.field == 'u.createdAt' %}selected{% endif %}>Date création</option>
                        <option value="u.id" {% if sort.field is defined and sort.field == 'u.id' %}selected{% endif %}>ID</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label for="sort_direction" class="form-label">Ordre</label>
                    <select class="form-select" id="sort_direction" name="sort_direction">
                        <option value="ASC" {% if sort.direction is defined and sort.direction == 'ASC' %}selected{% endif %}>Croissant (A-Z)</option>
                        <option value="DESC" {% if sort.direction is defined and sort.direction == 'DESC' %}selected{% endif %}>Décroissant (Z-A)</option>
                    </select>
                </div>
                
                <div class="col-md-12">
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Appliquer les filtres
                            </button>
                            <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
                                <i class="fas fa-undo"></i> Réinitialiser
                            </a>
                        </div>
                        
                        {% if filters is defined and ((filters.search is defined and filters.search) or (filters.role is defined and filters.role)) %}
                        <div>
                            <a href="{{ path('app_user_export_filtered', {
                                'search': filters.search is defined ? filters.search : '',
                                'role': filters.role is defined ? filters.role : '',
                                'sort_field': sort.field,
                                'sort_direction': sort.direction
                            }) }}" class="btn btn-success">
                                <i class="fas fa-file-export"></i> Exporter les résultats
                            </a>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Résultats -->
    <div class="card">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-list"></i> Liste des Utilisateurs
                {% if total_users is defined %}
                <span class="badge bg-secondary ms-2">{{ total_users }} résultat(s)</span>
                {% endif %}
            </h5>
            <div class="form-text">
                <i class="fas fa-info-circle"></i> Cliquez sur les en-têtes pour trier
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>
                                <a href="{{ path('app_user_filter', {
                                    'search': filters.search is defined ? filters.search : '',
                                    'role': filters.role is defined ? filters.role : '',
                                    'sort_field': 'u.id',
                                    'sort_direction': (sort.field is defined and sort.field == 'u.id' and sort.direction == 'ASC') ? 'DESC' : 'ASC'
                                }) }}" class="text-decoration-none text-dark">
                                    ID 
                                    {% if sort.field is defined and sort.field == 'u.id' %}
                                        <i class="fas fa-sort-{{ sort.direction == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_user_filter', {
                                    'search': filters.search is defined ? filters.search : '',
                                    'role': filters.role is defined ? filters.role : '',
                                    'sort_field': 'u.lastName',
                                    'sort_direction': (sort.field is defined and sort.field == 'u.lastName' and sort.direction == 'ASC') ? 'DESC' : 'ASC'
                                }) }}" class="text-decoration-none text-dark">
                                    Nom 
                                    {% if sort.field is defined and sort.field == 'u.lastName' %}
                                        <i class="fas fa-sort-{{ sort.direction == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_user_filter', {
                                    'search': filters.search is defined ? filters.search : '',
                                    'role': filters.role is defined ? filters.role : '',
                                    'sort_field': 'u.firstName',
                                    'sort_direction': (sort.field is defined and sort.field == 'u.firstName' and sort.direction == 'ASC') ? 'DESC' : 'ASC'
                                }) }}" class="text-decoration-none text-dark">
                                    Prénom 
                                    {% if sort.field is defined and sort.field == 'u.firstName' %}
                                        <i class="fas fa-sort-{{ sort.direction == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_user_filter', {
                                    'search': filters.search is defined ? filters.search : '',
                                    'role': filters.role is defined ? filters.role : '',
                                    'sort_field': 'u.email',
                                    'sort_direction': (sort.field is defined and sort.field == 'u.email' and sort.direction == 'ASC') ? 'DESC' : 'ASC'
                                }) }}" class="text-decoration-none text-dark">
                                    Email 
                                    {% if sort.field is defined and sort.field == 'u.email' %}
                                        <i class="fas fa-sort-{{ sort.direction == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Téléphone</th>
                            <th>Rôles</th>
                            <th>Créé le</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.lastName }}</td>
                            <td>{{ user.firstName }}</td>
                            <td>
                                <a href="mailto:{{ user.email }}" class="text-decoration-none">
                                    {{ user.email }}
                                </a>
                            </td>
                            <td>
                                {% if user.phone %}
                                    <a href="tel:{{ user.phone }}" class="text-decoration-none">
                                        {{ user.phone }}
                                    </a>
                                {% else %}
                                    <span class="text-muted">N/A</span>
                                {% endif %}
                            </td>
                            <td>
                                {% for role in user.roles %}
                                    {% if role == 'ROLE_ADMIN' %}
                                        <span class="badge bg-danger">Administrateur</span>
                                    {% elseif role == 'ROLE_VET' %}
                                        <span class="badge bg-warning">Vétérinaire</span>
                                    {% elseif role == 'ROLE_USER' %}
                                        <span class="badge bg-success">Client</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ role }}</span>
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                <span class="small" title="{{ user.createdAt|date('d/m/Y H:i:s') }}">
                                    {{ user.createdAt|date('d/m/Y') }}
                                </span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-info" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') and app.user.id != user.id %}
                                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" 
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');"
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button class="btn btn-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <div class="text-muted">
                                    <i class="fas fa-users fa-2x mb-3"></i>
                                    <p class="mb-0">Aucun utilisateur trouvé</p>
                                    {% if filters is defined and ((filters.search is defined and filters.search) or (filters.role is defined and filters.role)) %}
                                    <small class="mt-2 d-block">
                                        Essayez de modifier vos critères de recherche
                                    </small>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
.table th a {
    color: inherit;
    text-decoration: none;
}

.table th a:hover {
    color: #0d6efd;
}

.badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
}

.card-header.bg-light {
    background-color: #f8f9fa !important;
    border-bottom: 1px solid #dee2e6;
}

.btn-group-sm .btn {
    padding: 0.25rem 0.5rem;
}
</style>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Effacer le champ de recherche
    document.getElementById('clear-search')?.addEventListener('click', function() {
        document.getElementById('search').value = '';
        document.getElementById('search').focus();
    });
    
    // Auto-submit quand on change le tri
    document.getElementById('sort_field')?.addEventListener('change', function() {
        document.getElementById('filter-form').submit();
    });
    
    document.getElementById('sort_direction')?.addEventListener('change', function() {
        document.getElementById('filter-form').submit();
    });
    
    document.getElementById('role')?.addEventListener('change', function() {
        document.getElementById('filter-form').submit();
    });
    
    // Auto-submit après un délai dans la recherche
    let searchTimeout;
    document.getElementById('search')?.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            document.getElementById('filter-form').submit();
        }, 500);
    });
    
    // Tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>
{% endblock %}
{% endblock %}