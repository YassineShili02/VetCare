{% extends 'base.html.twig' %}

{% block title %}Statistiques des utilisateurs{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-chart-bar"></i> Statistiques des utilisateurs</h1>
        <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <!-- Cartes de statistiques -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h2 class="display-4 text-primary">{{ total_users }}</h2>
                    <p class="text-muted mb-0">Utilisateurs total</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h2 class="display-4 text-success">{{ stats['Client'] ?? 0 }}</h2>
                    <p class="text-muted mb-0">Clients</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h2 class="display-4 text-warning">{{ stats['Vétérinaire'] ?? 0 }}</h2>
                    <p class="text-muted mb-0">Vétérinaires</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-danger">
                <div class="card-body text-center">
                    <h2 class="display-4 text-danger">{{ stats['Administrateur'] ?? 0 }}</h2>
                    <p class="text-muted mb-0">Administrateurs</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Répartition par rôle -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Répartition par rôle</h5>
                </div>
                <div class="card-body">
                    <div style="height: 300px;">
                        <canvas id="roleChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-history"></i> Derniers inscrits</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Email</th>
                                    <th>Rôle</th>
                                    <th>Inscrit le</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in recent_users %}
                                <tr>
                                    <td>
                                        <a href="{{ path('app_user_show', {'id': user.id}) }}">
                                            {{ user.firstName }} {{ user.lastName }}
                                        </a>
                                    </td>
                                    <td>{{ user.email }}</td>
                                    <td>
                                        <span class="badge bg-{{ 
                                            user.isAdmin() ? 'danger' : 
                                            user.isVeterinarian() ? 'warning' : 'success' 
                                        }}">
                                            {{ user.roleLabel }}
                                        </span>
                                    </td>
                                    <td>{{ user.createdAt|date('d/m/Y') }}</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted">
                                        Aucun utilisateur récent
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Export des données -->
    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-download"></i> Export des données</h5>
        </div>
        <div class="card-body">
            <div class="btn-group">
                <a href="{{ path('app_user_export_csv') }}" class="btn btn-outline-primary">
                    <i class="fas fa-file-csv"></i> Exporter en CSV
                </a>
                <a href="{{ path('app_user_export_filtered') }}" class="btn btn-outline-success">
                    <i class="fas fa-file-excel"></i> Exporter les filtres
                </a>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript pour les graphiques -->
{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Données pour le graphique
    const roleData = {
        labels: ['Clients', 'Vétérinaires', 'Administrateurs'],
        datasets: [{
            data: [
                {{ stats['Client'] ?? 0 }},
                {{ stats['Vétérinaire'] ?? 0 }},
                {{ stats['Administrateur'] ?? 0 }}
            ],
            backgroundColor: [
                '#28a745', // Vert pour clients
                '#ffc107', // Jaune pour vétérinaires
                '#dc3545'  // Rouge pour administrateurs
            ],
            borderWidth: 2,
            borderColor: '#fff'
        }]
    };

    // Configuration du graphique
    const config = {
        type: 'pie',
        data: roleData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 20,
                        usePointStyle: true,
                        font: {
                            size: 14
                        }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            let label = context.label || '';
                            if (label) {
                                label += ': ';
                            }
                            label += context.parsed + ' utilisateur(s)';
                            return label;
                        }
                    }
                }
            }
        }
    };

    // Rendu du graphique
    const ctx = document.getElementById('roleChart').getContext('2d');
    new Chart(ctx, config);
});
</script>
{% endblock %}

<style>
.card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    border: 1px solid rgba(0, 0, 0, 0.125);
    border-radius: 10px;
    transition: transform 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
}

.display-4 {
    font-weight: 300;
    line-height: 1.2;
}

.badge {
    font-size: 0.85em;
    padding: 0.35em 0.65em;
}

.table th {
    border-top: none;
    font-weight: 600;
    color: #495057;
}

.table tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
}
</style>
{% endblock %}