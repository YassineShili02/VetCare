{% extends 'base.html.twig' %}

{% block title %}Modifier Utilisateur - {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="fas fa-edit"></i> Modifier {{ user.firstName }} {{ user.lastName }}
                    </h2>
                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-info btn-sm">
                        <i class="fas fa-eye"></i> Voir
                    </a>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.firstName, {
                                'label': 'Prénom',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.lastName, {
                                'label': 'Nom', 
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>
                    
                    {{ form_row(form.email, {
                        'label': 'Email',
                        'attr': {'class': 'form-control'}
                    }) }}
                    
                    {{ form_row(form.phone, {
                        'label': 'Téléphone',
                        'attr': {'class': 'form-control'}
                    }) }}
                    
                    {{ form_row(form.address, {
                        'label': 'Adresse',
                        'attr': {'class': 'form-control', 'rows': 3}
                    }) }}
                    
                    {{ form_row(form.roles, {
                        'label': 'Rôles',
                        'attr': {'class': 'form-check'}
                    }) }}

                    {# Note sur le mot de passe #}
                    <div class="alert alert-info mt-4">
                        <i class="fas fa-info-circle"></i>
                        <strong>Information :</strong> Le mot de passe ne peut pas être modifié ici. 
                        Pour changer le mot de passe, utilisez la fonction de réinitialisation.
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Retour à la liste
                                </a>
                            </div>
                            <div class="btn-group">
                                <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-info">
                                    <i class="fas fa-eye"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save"></i> Enregistrer
                                </button>
                            </div>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<style>
.card {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}
.form-check {
    padding-left: 0;
}
.form-check-input {
    margin-right: 0.5rem;
}
</style>
{% endblock %}