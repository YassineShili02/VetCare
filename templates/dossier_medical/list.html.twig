{% extends 'template.html.twig' %}

{% block title %}Liste des Dossiers Médicaux{% endblock %}

{% block content %}
    <section class="main-content section-padding">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white text-center">
                            <h3><i class="fas fa-notes-medical me-2"></i>Liste des Dossiers Médicaux</h3>
                        </div>
                        <div class="card-body">

                            {# Bouton Ajouter Dossier pour ROLE_VET et ROLE_ADMIN #}
                            {% if is_granted('ROLE_VET') or is_granted('ROLE_ADMIN') %}
                                <div class="mb-3 text-end">
                                    <a href="{{ path('addForm_dossier') }}" class="btn btn-success">
                                        <i class="fas fa-plus me-1"></i> Ajouter Dossier
                                    </a>
                                </div>
                            {% endif %}

                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle text-center">
                                    <thead class="table-dark">
                                    <tr>
                                        {% set columns = {
                                            'idDossier': '#',
                                            'numeroDossier': 'Numéro Dossier',
                                            'dateCreation': 'Date Création',
                                            'poids': 'Poids (kg)',
                                            'etat': 'État',
                                            'animal': 'Animal'
                                        } %}

                                        {% for key, label in columns %}
                                            <th>
                                                <a href="{{ path('lists_dossiers', {
                                                    sort: key,
                                                    order: sort == key and order == 'ASC' ? 'DESC' : 'ASC',
                                                    page: 1
                                                }) }}" class="text-white text-decoration-none">
                                                    {{ label }}
                                                    {% if sort == key %}
                                                        {% if order == 'ASC' %} ▲ {% else %} ▼ {% endif %}
                                                    {% endif %}
                                                </a>
                                            </th>
                                        {% endfor %}
                                        <th>Actions</th>
                                    </tr>
                                    </thead>

                                    <tbody>
                                    {% for dossier in tabdossiers %}
                                        <tr>
                                            <td>{{ dossier.idDossier }}</td>
                                            <td>{{ dossier.numeroDossier }}</td>
                                            <td>{{ dossier.dateCreation ? dossier.dateCreation|date('d/m/Y') : '' }}</td>
                                            <td>{{ dossier.poids }}</td>
                                            <td>{{ dossier.etat }}</td>
                                            <td>{{ dossier.animal ? dossier.animal.nom : '' }}</td>
                                            <td>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-primary btn-sm dropdown-toggle"
                                                            data-bs-toggle="dropdown" aria-expanded="false">
                                                        Actions
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        <li>
                                                            <a class="dropdown-item" href="{{ path('show_dossier', {'id': dossier.idDossier}) }}">
                                                                <i class="fas fa-eye me-1"></i> Voir
                                                            </a>
                                                        </li>
                                                        {% if is_granted('ROLE_VET') or is_granted('ROLE_ADMIN') %}
                                                            <li>
                                                                <a class="dropdown-item" href="{{ path('update_dossier', {'id': dossier.idDossier}) }}">
                                                                    <i class="fas fa-edit me-1"></i> Modifier
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" href="{{ path('remove_dossier', {'id': dossier.idDossier}) }}"
                                                                   onclick="return confirm('Voulez-vous vraiment supprimer ce dossier ?')">
                                                                    <i class="fas fa-trash me-1"></i> Supprimer
                                                                </a>
                                                            </li>
                                                            {# Ajouter Dossier uniquement si l'animal n'a pas encore de dossier #}
                                                            {% if not dossier.animal.getDossierAnimal() %}
                                                                <li>
                                                                    <a class="dropdown-item" href="{{ path('add_dossier_for_animal', {'animalId': dossier.animal.idAnimal}) }}">
                                                                        <i class="fas fa-plus me-1"></i> Ajouter Dossier
                                                                    </a>
                                                                </li>
                                                            {% endif %}
                                                        {% endif %}
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="7" class="text-center">Aucun dossier médical trouvé.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            {# Pagination #}
                            {% if tabdossiers.totalItemCount > 0 %}
                                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                                    <div class="text-muted">
                                        <i class="fas fa-info-circle me-2"></i>
                                        Affichage de
                                        <strong>{{ (tabdossiers.currentPageNumber - 1) * tabdossiers.itemNumberPerPage + 1 }}</strong>
                                        à
                                        <strong>{{ min(tabdossiers.currentPageNumber * tabdossiers.itemNumberPerPage, tabdossiers.totalItemCount) }}</strong>
                                        sur
                                        <strong>{{ tabdossiers.totalItemCount }}</strong> dossier(s)
                                    </div>

                                    <div class="pagination-wrapper">
                                        <nav aria-label="Pagination">
                                            <ul class="pagination">
                                                {% if tabdossiers.currentPageNumber > 1 %}
                                                    <li class="page-item">
                                                        <a class="page-link" href="{{ path('lists_dossiers', { page: tabdossiers.currentPageNumber - 1, sort: sort, order: order }) }}">
                                                            <i class="fas fa-chevron-left"></i> Précédent
                                                        </a>
                                                    </li>
                                                {% else %}
                                                    <li class="page-item disabled"><span class="page-link"><i class="fas fa-chevron-left"></i> Précédent</span></li>
                                                {% endif %}

                                                {% for page in 1..tabdossiers.pageCount %}
                                                    {% if page == tabdossiers.currentPageNumber %}
                                                        <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                                                    {% else %}
                                                        <li class="page-item"><a class="page-link" href="{{ path('lists_dossiers', { page: page, sort: sort, order: order }) }}">{{ page }}</a></li>
                                                    {% endif %}
                                                {% endfor %}

                                                {% if tabdossiers.currentPageNumber < tabdossiers.pageCount %}
                                                    <li class="page-item">
                                                        <a class="page-link" href="{{ path('lists_dossiers', { page: tabdossiers.currentPageNumber + 1, sort: sort, order: order }) }}">
                                                            Suivant <i class="fas fa-chevron-right"></i>
                                                        </a>
                                                    </li>
                                                {% else %}
                                                    <li class="page-item disabled"><span class="page-link">Suivant <i class="fas fa-chevron-right"></i></span></li>
                                                {% endif %}
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            {% endif %}

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
