<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dossier Médical {{ dossier.numeroDossier }}</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            color: #333;
            margin: 20px;
        }

        h1, h2 {
            color: #2c3e50;
        }

        .section {
            margin-bottom: 25px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        img.medical-image {
            display: block;
            width: 100%;
            max-width: 800px;
            height: auto;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

<h1>Dossier Médical - {{ dossier.numeroDossier }}</h1>

<div class="section">
    <h2>Informations de l'animal</h2>
    <table>
        <tr><th>Nom</th><td>{{ dossier.animal.nom }}</td></tr>
        <tr><th>Type</th><td>{{ dossier.animal.typeAnimal }}</td></tr>
        <tr><th>Sexe</th><td>{{ dossier.animal.sexe == 'M' ? 'Mâle' : 'Femelle' }}</td></tr>
        <tr><th>Poids</th><td>{{ dossier.poids }} kg</td></tr>
        <tr><th>Date de naissance</th><td>{{ dossier.animal.dateNaissance|date('d/m/Y') }}</td></tr>
    </table>
</div>
<div class="section">
    <h2>État de santé</h2>
    <p>{{ dossier.etat }}</p>
</div>

<div class="section">
    <h2>Notes vétérinaire</h2>
    <p>{{ dossier.notesVeterinaire }}</p>
</div>

<div class="section">
    <h2>Allergies</h2>
    <p>{{ dossier.allergies ?: 'Aucune' }}</p>
</div>

<div class="section">
    <h2>Vaccinations</h2>
    <p>{{ dossier.vaccinations ?: 'Aucun traitement' }}</p>
</div>

<div class="section">
    <h2>Antécédents médicaux</h2>
    <p>{{ dossier.antecedentsMedicaux ?: 'Aucun' }}</p>
</div>

<div class="section">
    <h2>Images médicales</h2>
    {% if dossier.images %}
        {% for image in dossier.images %}
            {# Chemin absolu vers le serveur pour Dompdf #}
            <img src="{{ base_path ~ '/uploads/dossier_medical/' ~ image }}"
                 alt="Image médicale"
                 class="medical-image">

        {% endfor %}
    {% else %}
        <p>Aucune image disponible.</p>
    {% endif %}
</div>

</body>
</html>
