{% extends 'base.html.twig' %}

{% block title %}Éditer le rendez-vous - VetCare{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-edit"></i>
                        Éditer le rendez-vous #{{ rendezvous.id }}
                    </h4>
                </div>
                <div class="card-body">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {{ form_start(form) }}
                        
                        <h5 class="border-bottom pb-2 mb-3">Informations Client</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                {{ form_row(form.nomClient) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                {{ form_row(form.emailClient) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                {{ form_row(form.telephoneClient) }}
                            </div>
                        </div>

                        <h5 class="border-bottom pb-2 mb-3 mt-4">Informations Animal</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.nomAnimal) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.especeAnimal) }}
                            </div>
                        </div>

                        <h5 class="border-bottom pb-2 mb-3 mt-4">Détails du rendez-vous</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.dateHeure) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.type) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.veterinaire) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.statut) }}
                            </div>
                        </div>

                        <h5 class="border-bottom pb-2 mb-3 mt-4">Notes</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.notesClient) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.notesVeterinaire) }}
                            </div>
                        </div>

                        <h5 class="border-bottom pb-2 mb-3 mt-4">Paiement</h5>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                {{ form_row(form.statutPaiement) }}
                            </div>
                            <div class="col-md-3 mb-3">
                                {{ form_row(form.montantPaiement) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.methodePaiement) }}
                            </div>
                        </div>

                        {{ form_rest(form) }}

                        <hr class="my-4">

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                            <a href="{{ path('rendezvous_list') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Retour à la liste
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}