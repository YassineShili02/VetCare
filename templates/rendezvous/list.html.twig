{% extends 'base.html.twig' %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Liste des Rendez-vous</h1>
    <a href="{{ path('rendezvous_add') }}" class="btn btn-success">➕ Ajouter un rendez-vous</a>
</div>

<table class="table table-striped table-hover shadow-sm bg-white">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Durée</th>
            <th>Commentaire Client</th>
            <th>Notes Vétérinaire</th>
            <th>Confirmation</th>
            <th>Mode Paiement</th>
            <th>Créé le</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for r in rendezvous %}
            <tr>
                <td>{{ r.id }}</td>
                <td>{{ r.type }}</td>
                <td>{{ r.duree }} min</td>
                <td>{{ r.commentaireClient }}</td>
                <td>{{ r.notesVeterinaire }}</td>
                <td>{{ r.confirmation ? 'Oui' : 'Non' }}</td>
                <td>{{ r.modePaiementPrevu }}</td>
                <td>{{ r.createdAt|date('Y-m-d H:i') }}</td>
                <td>
                    <a href="{{ path('rendezvous_edit', {id: r.id}) }}" class="btn btn-sm btn-primary">✏️ Edit</a>
                    <a href="{{ path('rendezvous_delete', {id: r.id}) }}" 
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Supprimer ce rendez-vous ?');">❌ Delete</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9" class="text-center">Aucun rendez-vous trouvé.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
