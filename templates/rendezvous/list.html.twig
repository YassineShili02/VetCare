{% extends 'base.html.twig' %}

{% block title %}Gestion des rendez-vous - VetCare{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">
        <i class="fas fa-calendar-alt"></i> Gestion des rendez-vous
    </h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label for="statut" class="form-label">Statut</label>
                    <select name="statut" id="statut" class="form-select">
                        <option value="">Tous les statuts</option>
                        <option value="en_attente" {% if currentStatut == 'en_attente' %}selected{% endif %}>En attente</option>
                        <option value="confirme" {% if currentStatut == 'confirme' %}selected{% endif %}>Confirmé</option>
                        <option value="refuse" {% if currentStatut == 'refuse' %}selected{% endif %}>Refusé</option>
                        <option value="termine" {% if currentStatut == 'termine' %}selected{% endif %}>Terminé</option>
                        <option value="annule" {% if currentStatut == 'annule' %}selected{% endif %}>Annulé</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="vet" class="form-label">Vétérinaire</label>
                    <select name="vet" id="vet" class="form-select">
                        <option value="">Tous les vétérinaires</option>
                        {% for veterinaire in veterinaires %}
                            <option value="{{ veterinaire.id }}" {% if currentVet == veterinaire.id %}selected{% endif %}>
                                {{ veterinaire }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter"></i> Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau des rendez-vous -->
    <div class="card">
        <div class="card-body">
            {% if rendezvous is empty %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Aucun rendez-vous trouvé.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Date/Heure</th>
                                <th>Client</th>
                                <th>Animal</th>
                                <th>Type</th>
                                <th>Vétérinaire</th>
                                <th>Statut</th>
                                <th>Paiement</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rdv in rendezvous %}
                                <tr>
                                    <td>
                                        <strong>{{ rdv.dateHeure|date('d/m/Y') }}</strong><br>
                                        <small class="text-muted">{{ rdv.dateHeure|date('H:i') }}</small>
                                    </td>
                                    <td>
                                        {{ rdv.nomClient }}<br>
                                        <small class="text-muted">
                                            {% if rdv.telephoneClient %}
                                                <i class="fas fa-phone"></i> {{ rdv.telephoneClient }}
                                            {% endif %}
                                        </small>
                                    </td>
                                    <td>
                                        {% if rdv.nomAnimal %}
                                            {{ rdv.nomAnimal }}<br>
                                            <small class="text-muted">{{ rdv.especeAnimal }}</small>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ rdv.type }}</span>
                                    </td>
                                    <td>
                                        {% if rdv.veterinaire %}
                                            {{ rdv.veterinaire.prenom }} {{ rdv.veterinaire.nom }}
                                        {% else %}
                                            <span class="text-muted">Non assigné</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-{{ rdv.statutBadgeClass }}">
                                            {{ rdv.statut|replace({'_': ' '})|title }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-{{ rdv.statutPaiementBadgeClass }}">
                                            {{ rdv.statutPaiement|replace({'_': ' '})|title }}
                                        </span>
                                        {% if rdv.montantPaiement %}
                                            <br><small>{{ rdv.montantPaiement }} TND</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            {% if rdv.statut == 'en_attente' %}
                                                <a href="{{ path('rendezvous_approve', {id: rdv.id}) }}" 
                                                   class="btn btn-success" title="Approuver">
                                                    <i class="fas fa-check"></i>
                                                </a>
                                                <a href="{{ path('rendezvous_reject', {id: rdv.id}) }}" 
                                                   class="btn btn-danger" title="Refuser">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            {% endif %}
                                            <a href="{{ path('rendezvous_edit', {id: rdv.id}) }}" 
                                               class="btn btn-primary" title="Éditer">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="{{ path('rendezvous_delete', {id: rdv.id}) }}" 
                                                  style="display: inline;"
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rendez-vous ?');">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}