{% extends 'base.html.twig' %}

{% block title %}Ajouter un rendez-vous{% endblock %}

{% block body %}
<section class="container py-5">

    <div class="bg-white p-4 shadow rounded" style="max-width: 650px; margin: 0 auto;">

        <h2 class="text-center mb-4" style="color:#2c3e50;">
            ➕ Créer un rendez-vous
        </h2>

        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.type, 'Type de rendez-vous') }}
            {{ form_widget(form.type, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.type) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.duree, 'Durée (minutes)') }}
            {{ form_widget(form.duree, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.duree) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.commentaireClient, 'Commentaire client') }}
            {{ form_widget(form.commentaireClient, {'attr': {'class': 'form-control', 'rows': 4}}) }}
            {{ form_errors(form.commentaireClient) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.notesVeterinaire, 'Notes vétérinaire') }}
            {{ form_widget(form.notesVeterinaire, {'attr': {'class': 'form-control', 'rows': 4}}) }}
            {{ form_errors(form.notesVeterinaire) }}
        </div>

        <div class="mb-3 form-check">
            {{ form_widget(form.confirmation, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form.confirmation, 'Rendez-vous confirmé', {'label_attr': {'class': 'form-check-label'}}) }}
            {{ form_errors(form.confirmation) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.modePaiementPrevu, 'Mode de paiement prévu') }}
            {{ form_widget(form.modePaiementPrevu, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.modePaiementPrevu) }}
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('rendezvous_list') }}" class="btn btn-secondary">
                ← Retour
            </a>

            <button type="submit" class="btn btn-success">
                💾 Enregistrer
            </button>
        </div>

        {{ form_end(form) }}

    </div>

</section>
{% endblock %}
