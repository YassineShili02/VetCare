{% extends 'frontoffice/base.html.twig' %}

{% block title %}Liste des Traitements - Frontoffice{% endblock %}

{% block body %}
<div class="card-grid">
    {% for traitement in traitements %}
    <div class="card">
        <div class="card-header">
            <h3 style="margin: 0; color: white;">{{ traitement.nom }}</h3>
        </div>
        <div class="card-body">
            <div class="card-text">
                {{ traitement.description|default('Aucune description disponible') }}
            </div>

            <div class="card-details">
                <div class="detail-item">
                    <span class="detail-label">Statut:</span>
                    <span class="detail-value">
                        <span class="statut-badge statut-{{ traitement.statut }}">
                            {% if traitement.statut == 'pending' %}En attente
                            {% elseif traitement.statut == 'in_progress' %}En cours
                            {% elseif traitement.statut == 'completed' %}Terminé
                            {% elseif traitement.statut == 'cancelled' %}Annulé
                            {% else %}{{ traitement.statut }}
                            {% endif %}
                        </span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Date création:</span>
                    <span class="detail-value">{{ traitement.dateCreation|date('d/m/Y') }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Médicaments:</span>
                    <span class="detail-value">{{ traitement.medicaments|length }}</span>
                </div>
            </div>

            {% if traitement.medicaments|length > 0 %}
            <div class="medicament-list">
                <strong>Médicaments associés:</strong>
                {% for medicament in traitement.medicaments %}
                <div class="medicament-item">
                    <span>{{ medicament.nom }}</span>
                    <span class="stock-indicator {{ medicament.stock > 10 ? 'stock-high' : (medicament.stock > 0 ? 'stock-medium' : 'stock-low') }}">
                        Stock: {{ medicament.stock }}
                    </span>
                </div>
                {% endfor %}
            </div>
            {% endif %}

            <div class="actions">
                <button class="btn btn-accept" onclick="acceptTraitement({{ traitement.id }})">Accepter</button>
                <button class="btn btn-refuse" onclick="refuseTraitement({{ traitement.id }})">Refuser</button>
            </div>
        </div>
    </div>
    {% else %}
    <div style="text-align: center; color: white; grid-column: 1 / -1;">
        <h3>Aucun traitement disponible</h3>
    </div>
    {% endfor %}
</div>

<a href="{{ path('app_home') }}" class="btn-back">🏠 Retour à l'accueil</a>
<a href="{{ path('app_traitement_index') }}" class="btn-back">Retour au Backoffice</a>

<script>
function acceptTraitement(id) {
    if (confirm('Êtes-vous sûr de vouloir accepter ce traitement ?')) {
        alert('Traitement ' + id + ' accepté avec succès !');
        // Ici vous pouvez ajouter un appel AJAX pour mettre à jour le statut
    }
}

function refuseTraitement(id) {
    if (confirm('Êtes-vous sûr de vouloir refuser ce traitement ?')) {
        alert('Traitement ' + id + ' refusé !');
        // Ici vous pouvez ajouter un appel AJAX pour mettre à jour le statut
    }
}
</script>

{% endblock %}