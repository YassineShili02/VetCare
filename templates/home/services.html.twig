{% extends 'base.html.twig' %}

{% block title %}Nos Services - VetCare{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <h1 class="text-center mb-5">Nos Services</h1>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">🏥 Consultations</h3>
                    <p class="card-text">
                        Consultations générales et spécialisées pour tous types d'animaux de compagnie.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">💉 Vaccinations</h3>
                    <p class="card-text">
                        Programme de vaccination complet pour protéger votre animal contre les maladies.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">🔬 Analyses</h3>
                    <p class="card-text">
                        Laboratoire d'analyses médicales sur place pour un diagnostic rapide.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">⚕️ Chirurgie</h3>
                    <p class="card-text">
                        Interventions chirurgicales avec équipement moderne et stérilisation complète.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">🦷 Soins Dentaires</h3>
                    <p class="card-text">
                        Détartrage, extraction et soins dentaires pour maintenir une bonne hygiène bucco-dentaire.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">🚨 Urgences</h3>
                    <p class="card-text">
                        Service d'urgence disponible pour les situations critiques de votre animal.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}