{% extends 'base.html.twig' %}

{% block title %}À propos - VetCare{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-lg-12">
            <h1 class="text-center mb-4">À propos de VetCare</h1>

            <div class="about-content">
                <h2>Notre Clinique Vétérinaire</h2>
                <p>
                    VetCare est une clinique vétérinaire dédiée au bien-être de vos animaux de compagnie.
                    Depuis notre création, nous offrons des soins de qualité avec passion et professionnalisme.
                </p>

                <h3>Notre Mission</h3>
                <p>
                    Offrir des soins vétérinaires de haute qualité dans un environnement chaleureux et accueillant.
                    Nous nous engageons à traiter chaque animal avec respect, compassion et expertise.
                </p>

                <h3>Notre Équipe</h3>
                <p>
                    Notre équipe est composée de vétérinaires expérimentés et d'assistants dévoués,
                    tous passionnés par le soin des animaux.
                </p>

                <h3>Nos Valeurs</h3>
                <ul>
                    <li>Excellence dans les soins vétérinaires</li>
                    <li>Compassion envers tous les animaux</li>
                    <li>Écoute et conseil personnalisé</li>
                    <li>Équipements modernes et techniques avancées</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}