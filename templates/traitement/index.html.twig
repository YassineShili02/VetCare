{% extends 'base.html.twig' %}

{% block title %}Gestion des Traitements - PetCare{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">
            <i class="fas fa-stethoscope me-3"></i>Gestion des Traitements
        </h1>
        <p class="lead">Gérez les traitements et prescriptions vétérinaires</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">Liste des Traitements</h2>
        <a href="{{ path('traitement_new') }}" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Nouveau Traitement
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="text-center">ID</th>
                            <th>Nom du Traitement</th>
                            <th>Description</th>
                            <th>Médicaments Associés</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for traitement in traitements %}
                        <tr class="hover-row">
                            <td class="text-center">
                                <span class="badge bg-primary rounded-pill">#{{ traitement.id }}</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-stethoscope text-primary me-2"></i>
                                    <strong>{{ traitement.nom }}</strong>
                                </div>
                            </td>
                            <td>
                                {% if traitement.description %}
                                    <div class="text-muted small">
                                        {{ traitement.description|slice(0, 60) }}{% if traitement.description|length > 60 %}...{% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted small">Aucune description</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if traitement.medicaments|length > 0 %}
                                    <div class="d-flex flex-wrap gap-1">
                                        {% for medicament in traitement.medicaments %}
                                            <span class="badge bg-info text-dark">
                                                <i class="fas fa-pill me-1"></i>{{ medicament.nom }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <span class="badge bg-light text-muted border">
                                        <i class="fas fa-times me-1"></i>Aucun médicament
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('traitement_edit', {'id': traitement.id}) }}"
                                       class="btn btn-outline-warning"
                                       data-bs-toggle="tooltip"
                                       title="Modifier le traitement">
                                        <i class="fas fa-edit"></i>
                                        <span class="d-none d-md-inline ms-1">Modifier</span>
                                    </a>
                                    <form method="post"
                                          action="{{ path('traitement_delete', {'id': traitement.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce traitement?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ traitement.id) }}">
                                        <button type="submit"
                                                class="btn btn-outline-danger"
                                                data-bs-toggle="tooltip"
                                                title="Supprimer le traitement">
                                            <i class="fas fa-trash"></i>
                                            <span class="d-none d-md-inline ms-1">Supprimer</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <div class="empty-state">
                                    <i class="fas fa-stethoscope fa-3x mb-3 text-muted"></i>
                                    <h4 class="text-muted">Aucun traitement trouvé</h4>
                                    <p class="text-muted">Commencez par créer votre premier traitement</p>
                                    <a href="{{ path('traitement_new') }}" class="btn btn-primary mt-2">
                                        <i class="fas fa-plus-circle me-2"></i>Créer un traitement
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Initialiser les tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })
</script>
{% endblock %}