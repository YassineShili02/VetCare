{% extends 'base.html.twig' %}

{% block title %}Modifier Traitement - PetCare{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-edit me-2"></i>Modifier le traitement
                </h4>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

                <div class="mb-3">
                    {{ form_label(form.nom, 'Nom du traitement', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                    <div class="invalid-feedback">
                        Veuillez saisir un nom pour le traitement.
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.medicaments, 'Médicaments associés', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.medicaments, {'attr': {'class': 'form-control select2', 'multiple': 'multiple'}}) }}
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-warning me-md-2">
                        <i class="fas fa-save me-2"></i>Modifier le traitement
                    </button>
                    <a href="{{ path('traitement_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    $(document).ready(function() {
        $('.select2').select2({
            placeholder: "Sélectionnez des médicaments",
            allowClear: true
        });
    });
</script>
{% endblock %}