{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - VetCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            {# LOGO VETCARE #}
            <div class="text-center mb-5">
                <h1 class="display-4 text-primary fw-bold">
                    <i class="fas fa-paw me-2"></i>VetCare
                </h1>
                <p class="text-muted">Réinitialisation de mot de passe</p>
            </div>

            <div class="card shadow-lg border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="fas fa-key me-2"></i>Mot de passe oublié
                    </h2>
                    
                    <p class="text-center text-muted mb-4">
                        Entrez votre adresse email pour recevoir un code de réinitialisation
                    </p>
                    
                    {# Messages Flash #}
                    <div class="flash-messages mb-4">
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('info') %}
                            <div class="alert alert-info alert-dismissible fade show" role="alert">
                                <i class="fas fa-info-circle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('debug') %}
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="fas fa-bug me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                    </div>
                    
                    {{ form_start(form, {
                        'attr': {
                            'class': 'needs-validation',
                            'novalidate': 'novalidate'
                        }
                    }) }}
                    
                        <div class="mb-4">
                            {{ form_label(form.email, null, {
                                'label_attr': {
                                    'class': 'form-label fw-bold'
                                }
                            }) }}
                            
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                {{ form_widget(form.email, {
                                    'attr': {
                                        'class': 'form-control form-control-lg' ~ (form.email.vars.errors|length ? ' is-invalid' : ''),
                                        'placeholder': 'votre@email.com',
                                        'autocomplete': 'email'
                                    }
                                }) }}
                            </div>
                            
                            {% if form.email.vars.errors %}
                                <div class="invalid-feedback d-block">
                                    {% for error in form.email.vars.errors %}
                                        <i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>Envoyer le code
                            </button>
                        </div>
                    {{ form_end(form) }}

                    <div class="text-center mt-4 pt-3 border-top">
                        <a href="{{ path('app_login') }}" class="text-decoration-none">
                            <i class="fas fa-arrow-left me-2"></i>Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="fas fa-shield-alt me-1"></i>
                    Votre sécurité est notre priorité. Nous ne partagerons jamais votre email.
                </small>
            </div>
        </div>
    </div>
</div>

<style>
.card {
    border-radius: 15px;
    border: none;
}

.input-group-text {
    background-color: #f8f9fa;
    border-right: none;
}

.form-control-lg {
    border-left: none;
    padding-left: 0;
}

.form-control:focus {
    box-shadow: 0 0 0 0.25rem rgba(44, 95, 45, 0.25);
    border-color: #2c5f2d;
}

.btn-primary {
    background-color: #2c5f2d;
    border-color: #2c5f2d;
    padding: 12px 24px;
    font-weight: 600;
    transition: all 0.3s;
}

.btn-primary:hover {
    background-color: #1e4620;
    border-color: #1e4620;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(44, 95, 45, 0.3);
}

.alert {
    border-radius: 10px;
    border: none;
}

.display-4 {
    color: #2c5f2d;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
}

@media (max-width: 768px) {
    .card-body {
        padding: 2rem !important;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Validation Bootstrap
    const forms = document.querySelectorAll('.needs-validation');
    
    Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            form.classList.add('was-validated');
        }, false);
    });
    
    // Auto-dismiss alerts after 5 seconds
    setTimeout(() => {
        document.querySelectorAll('.alert').forEach(alert => {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 5000);
});
</script>
{% endblock %}