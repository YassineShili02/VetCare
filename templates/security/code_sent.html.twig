{% extends 'base.html.twig' %}

{% block title %}Vérification du code - VetCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            {# LOGO VETCARE #}
            <div class="text-center mb-5">
                <h1 class="display-4 text-primary fw-bold">
                    <i class="fas fa-paw me-2"></i>VetCare
                </h1>
                <p class="text-muted">Vérification du code</p>
            </div>

            <div class="card shadow-lg border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="fas fa-key me-2"></i>Entrez votre code
                    </h2>
                    
                    <p class="text-center text-muted mb-4">
                        Code envoyé à :<br>
                        <strong class="text-primary">{{ email }}</strong>
                    </p>
                    
                    {# Messages Flash #}
                    <div class="flash-messages mb-4">
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                    </div>
                    
                    {# ⭐⭐ FORMULAIRE POUR ÉCRIRE LE CODE ⭐⭐ #}
                    <form method="post" action="{{ path('app_verify_code') }}">
                        <div class="mb-4">
                            <label for="code" class="form-label fw-bold">Code de vérification (6 chiffres)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-shield-alt text-primary"></i>
                                </span>
                                <input type="text" 
                                       name="code" 
                                       id="code"
                                       class="form-control text-center font-monospace" 
                                       placeholder="000000" 
                                       maxlength="6"
                                       pattern="[0-9]{6}"
                                       inputmode="numeric"
                                       autocomplete="one-time-code"
                                       required
                                       autofocus
                                       style="font-size: 24px; letter-spacing: 10px; height: 60px;">
                            </div>
                            <div class="form-text text-center mt-2">
                                Entrez les 6 chiffres reçus par email
                            </div>
                        </div>
                        
                        {# ⭐⭐ BOUTON 1 : VÉRIFIER LE CODE ⭐⭐ #}
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg py-3">
                                <i class="fas fa-check-circle me-2"></i>Vérifier le code
                            </button>
                        </div>
                    </form>
                    
                    {# ⭐⭐ BOUTON 2 : RENVOYER LE CODE ⭐⭐ #}
                    <div class="d-grid gap-2 mt-3">
                        <a href="{{ path('app_resend_code') }}" class="btn btn-outline-secondary btn-lg py-3">
                            <i class="fas fa-redo me-2"></i>Renvoyer un nouveau code
                        </a>
                    </div>
                    {# Après les messages flash #}
{% if app.environment == 'dev' %}
    <div class="alert alert-secondary small">
        <h6><i class="fas fa-bug me-2"></i>Debug Session</h6>
        <p class="mb-1">Email: {{ app.session.get('reset_email') }}</p>
        <p class="mb-1">Code: {{ app.session.get('reset_code') }}</p>
        <p class="mb-0">Session ID: {{ app.session.id }}</p>
    </div>
{% endif %}
                    
                    <div class="text-center mt-4 pt-3 border-top">
                        <a href="{{ path('app_forgot_password') }}" class="text-decoration-none">
                            <i class="fas fa-edit me-2"></i>Modifier l'email
                        </a>
                    </div>
                </div>
            </div>
            
            {# Instructions #}
            <div class="alert alert-light border mt-4">
                <div class="d-flex align-items-start">
                    <div class="me-3">
                        <i class="fas fa-info-circle fa-2x text-info"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="alert-heading">Besoin d'aide ?</h5>
                        <ul class="mb-0 ps-3">
                            <li>Vérifiez votre boîte de réception ({{ email }})</li>
                            <li>Cherchez l'email avec l'objet "VetCare Code:"</li>
                            <li>Si vous ne voyez pas l'email, vérifiez le dossier <strong>Spam</strong></li>
                            <li>Le code est valable <strong>15 minutes</strong></li>
                            <li>Cliquez sur "Renvoyer un nouveau code" si nécessaire</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card {
    border-radius: 15px;
    border: none;
}

.btn-primary {
    background-color: #2c5f2d;
    border-color: #2c5f2d;
    padding: 12px 24px;
    font-weight: 600;
    transition: all 0.3s;
}

.btn-primary:hover {
    background-color: #1e4620;
    border-color: #1e4620;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(44, 95, 45, 0.3);
}

.btn-outline-secondary:hover {
    background-color: #f8f9fa;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.font-monospace {
    font-family: 'Courier New', monospace;
}

.alert {
    border-radius: 10px;
    border: none;
}

/* Style spécial pour le champ code */
#code:focus {
    border-color: #2c5f2d;
    box-shadow: 0 0 0 0.25rem rgba(44, 95, 45, 0.25);
}

.input-group-text {
    background-color: #f8f9fa;
    border-right: none;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const codeInput = document.getElementById('code');
    
    // Auto-focus sur le champ code
    codeInput.focus();
    
    // Auto-dismiss alerts after 5 seconds
    setTimeout(() => {
        document.querySelectorAll('.alert').forEach(alert => {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 5000);
    
    // Formatage automatique : seulement chiffres, max 6
    codeInput.addEventListener('input', function(e) {
        // Garder seulement les chiffres
        let value = e.target.value.replace(/\D/g, '');
        
        // Limiter à 6 chiffres
        if (value.length > 6) {
            value = value.substring(0, 6);
        }
        
        e.target.value = value;
        
        // Changer la couleur quand 6 chiffres sont entrés
        if (value.length === 6) {
            e.target.style.backgroundColor = '#f0f8f0';
            e.target.style.borderColor = '#2c5f2d';
        } else {
            e.target.style.backgroundColor = '';
            e.target.style.borderColor = '';
        }
    });
    
    // Soumission automatique après 6 chiffres (optionnel)
    codeInput.addEventListener('keyup', function(e) {
        if (this.value.length === 6 && /^\d+$/.test(this.value)) {
            // Soumettre automatiquement après un petit délai
            setTimeout(() => {
                this.form.submit();
            }, 300);
        }
    });
    
    // Validation en temps réel
    codeInput.addEventListener('blur', function() {
        if (this.value.length > 0 && this.value.length < 6) {
            this.classList.add('is-invalid');
        } else {
            this.classList.remove('is-invalid');
        }
    });
});
</script>
{% endblock %}