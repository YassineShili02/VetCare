{# templates/security/password_reset_form.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Définir un nouveau mot de passe{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-key"></i> Définir un nouveau mot de passe
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i>
                        <strong>Vérification réussie !</strong>
                        <p class="mb-0 mt-2">Bonjour {{ user.firstName }}, vous pouvez maintenant définir votre nouveau mot de passe.</p>
                    </div>
                    
                    {{ form_start(form, {'attr': {'id': 'reset-password-form'}}) }}
                    
                    <div class="mb-4">
                        <div class="form-text mb-3">
                            <i class="fas fa-user-circle"></i> Compte: <strong>{{ user.email }}</strong>
                        </div>
                        
                        <!-- Nouveau mot de passe -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-key"></i> Nouveau mot de passe
                            </label>
                            <div class="input-group">
                                {{ form_widget(form.newPassword.first, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Nouveau mot de passe (min 6 caractères)',
                                    'id': 'new-password'
                                }}) }}
                                <button class="btn btn-outline-secondary" type="button" id="toggle-password">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            {{ form_errors(form.newPassword.first) }}
                            <div class="form-text">
                                <i class="fas fa-info-circle"></i> Minimum 6 caractères
                            </div>
                            <div id="password-strength" class="mt-2" style="display: none;">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" id="strength-bar" style="width: 0%"></div>
                                </div>
                                <small id="strength-text" class="form-text"></small>
                            </div>
                        </div>
                        
                        <!-- Confirmation -->
                        <div class="mb-4">
                            <label class="form-label">
                                <i class="fas fa-check-circle"></i> Confirmer le mot de passe
                            </label>
                            <div class="input-group">
                                {{ form_widget(form.newPassword.second, {'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Confirmez le mot de passe',
                                    'id': 'confirm-password'
                                }}) }}
                                <button class="btn btn-outline-secondary" type="button" id="toggle-confirm">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            {{ form_errors(form.newPassword.second) }}
                            <div class="invalid-feedback" id="match-error" style="display: none;">
                                Les mots de passe ne correspondent pas
                            </div>
                            <div class="valid-feedback" id="match-success" style="display: none;">
                                Les mots de passe correspondent
                            </div>
                        </div>
                        
                        <!-- Bouton de soumission -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg" id="submit-btn">
                                <i class="fas fa-save"></i> Enregistrer le nouveau mot de passe
                            </button>
                            <a href="{{ path('app_login') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-sign-in-alt"></i> Retour à la connexion
                            </a>
                        </div>
                        
                        <!-- Barre de progression -->
                        <div class="progress mt-3" id="submit-progress" style="display: none; height: 6px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                        </div>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript pour la validation -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const newPassword = document.getElementById('new-password');
    const confirmPassword = document.getElementById('confirm-password');
    const toggleBtn = document.getElementById('toggle-password');
    const toggleConfirmBtn = document.getElementById('toggle-confirm');
    const submitBtn = document.getElementById('submit-btn');
    const form = document.getElementById('reset-password-form');
    const lengthError = document.getElementById('password-length-error');
    
    // Toggle visibilité mot de passe
    toggleBtn?.addEventListener('click', function() {
        togglePasswordVisibility(newPassword, this);
    });
    
    toggleConfirmBtn?.addEventListener('click', function() {
        togglePasswordVisibility(confirmPassword, this);
    });
    
    function togglePasswordVisibility(input, button) {
        const icon = button.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }
    
    // Validation en temps réel pour la longueur
    newPassword?.addEventListener('input', function() {
        const password = this.value;
        
        // Validation longueur
        if (password.length > 0 && password.length < 6) {
            this.classList.add('is-invalid');
            lengthError.style.display = 'block';
        } else {
            this.classList.remove('is-invalid');
            lengthError.style.display = 'none';
        }
        
        // Vérification de la force
        checkPasswordStrength(password);
        validatePasswordMatch();
    });
    
    confirmPassword?.addEventListener('input', validatePasswordMatch);
    
    function checkPasswordStrength(password) {
        const strengthDiv = document.getElementById('password-strength');
        const strengthBar = document.getElementById('strength-bar');
        const strengthText = document.getElementById('strength-text');
        
        if (!password) {
            strengthDiv.style.display = 'none';
            return;
        }
        
        let strength = 0;
        if (password.length >= 6) strength++;
        if (password.length >= 8) strength++;
        if (/[a-z]/.test(password)) strength++;
        if (/[A-Z]/.test(password)) strength++;
        if (/[0-9]/.test(password)) strength++;
        if (/[^A-Za-z0-9]/.test(password)) strength++;
        
        strengthDiv.style.display = 'block';
        
        if (strength <= 2) {
            strengthBar.className = 'progress-bar bg-danger';
            strengthBar.style.width = '33%';
            strengthText.textContent = 'Faible';
            strengthText.className = 'form-text text-danger';
        } else if (strength <= 4) {
            strengthBar.className = 'progress-bar bg-warning';
            strengthBar.style.width = '66%';
            strengthText.textContent = 'Moyen';
            strengthText.className = 'form-text text-warning';
        } else {
            strengthBar.className = 'progress-bar bg-success';
            strengthBar.style.width = '100%';
            strengthText.textContent = 'Fort';
            strengthText.className = 'form-text text-success';
        }
    }
    
    function validatePasswordMatch() {
        const newPwd = newPassword?.value || '';
        const confirmPwd = confirmPassword?.value || '';
        const errorDiv = document.getElementById('match-error');
        const successDiv = document.getElementById('match-success');
        
        if (!confirmPwd) {
            confirmPassword.classList.remove('is-invalid', 'is-valid');
            if (errorDiv) errorDiv.style.display = 'none';
            if (successDiv) successDiv.style.display = 'none';
        } else if (newPwd !== confirmPwd) {
            confirmPassword.classList.add('is-invalid');
            confirmPassword.classList.remove('is-valid');
            if (errorDiv) errorDiv.style.display = 'block';
            if (successDiv) successDiv.style.display = 'none';
        } else {
            confirmPassword.classList.remove('is-invalid');
            confirmPassword.classList.add('is-valid');
            if (errorDiv) errorDiv.style.display = 'none';
            if (successDiv) successDiv.style.display = 'block';
        }
    }
    
    // Validation avant soumission
    form?.addEventListener('submit', function(e) {
        const newPwd = newPassword?.value || '';
        const confirmPwd = confirmPassword?.value || '';
        
        // Réinitialiser les erreurs
        newPassword.classList.remove('is-invalid');
        confirmPassword.classList.remove('is-invalid');
        if (lengthError) lengthError.style.display = 'none';
        
        // Validation longueur
        if (newPwd.length < 6) {
            e.preventDefault();
            newPassword.classList.add('is-invalid');
            if (lengthError) lengthError.style.display = 'block';
            newPassword.focus();
            showAlert('error', 'Le mot de passe doit contenir au moins 6 caractères');
            return;
        }
        
        // Validation correspondance
        if (newPwd !== confirmPwd) {
            e.preventDefault();
            confirmPassword.classList.add('is-invalid');
            confirmPassword.focus();
            showAlert('error', 'Les mots de passe ne correspondent pas');
            return;
        }
        
        // Afficher l'indicateur de chargement
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
        if (document.getElementById('submit-progress')) {
            document.getElementById('submit-progress').style.display = 'block';
        }
        
        // Confirmation (optionnel)
        if (!confirm('Êtes-vous sûr de vouloir changer votre mot de passe ?')) {
            e.preventDefault();
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Enregistrer le nouveau mot de passe';
            if (document.getElementById('submit-progress')) {
                document.getElementById('submit-progress').style.display = 'none';
            }
        }
    });
    
    // Validation initiale
    validatePasswordMatch();
    if (newPassword?.value) {
        checkPasswordStrength(newPassword.value);
        if (newPassword.value.length < 6) {
            newPassword.classList.add('is-invalid');
            if (lengthError) lengthError.style.display = 'block';
        }
    }
    
    // Fonction pour afficher les alertes
    function showAlert(type, message) {
        // Créer une alerte temporaire
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1050;';
        alertDiv.innerHTML = `
            <i class="fas ${type === 'error' ? 'fa-exclamation-triangle' : 'fa-check-circle'}"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(alertDiv);
        
        // Supprimer après 5 secondes
        setTimeout(() => {
            alertDiv.remove();
        }, 5000);
    }
});
</script>

<style>
.card {
    border: none;
    border-radius: 12px;
    overflow: hidden;
}

.card-header {
    border-bottom: none;
    padding: 1.5rem;
}

.progress-bar {
    transition: width 0.3s ease;
}

.form-control:focus {
    border-color: #28a745;
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
}

.btn-success {
    background-color: #28a745;
    border-color: #28a745;
    padding: 0.75rem;
    font-weight: 500;
}

.btn-success:hover {
    background-color: #218838;
    border-color: #1e7e34;
}
</style>
{% endblock %}