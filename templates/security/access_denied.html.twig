{# templates/security/access_denied.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accès refusé{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="card shadow-lg p-4">
                    <h1 class="display-4 text-danger"><i class="fas fa-exclamation-triangle"></i> Accès refusé</h1>
                    <p class="lead mt-3">Vous n'avez pas les droits nécessaires pour accéder à cette page.</p>
                    <a href="{{ path('app_dossier_medical') }}" class="btn btn-primary mt-3">
