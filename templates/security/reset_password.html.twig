{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - VetCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            {# LOGO VETCARE #}
            <div class="text-center mb-5">
                <h1 class="display-4 text-primary fw-bold">
                    <i class="fas fa-paw me-2"></i>VetCare
                </h1>
                <p class="text-muted">Création de votre nouveau mot de passe</p>
            </div>

            <div class="card shadow-lg border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="fas fa-lock me-2"></i>Nouveau mot de passe
                    </h2>
                    
                    <p class="text-center text-muted mb-4">
                        Veuillez saisir votre nouveau mot de passe
                    </p>
                    
                    {# Messages Flash #}
                    <div class="flash-messages mb-4">
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('warning') %}
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                    </div>
                    
                    {{ form_start(resetForm, {
                        'attr': {
                            'class': 'needs-validation',
                            'novalidate': 'novalidate'
                        }
                    }) }}
                    
                        {# Nouveau mot de passe #}
                        <div class="mb-4">
                            {{ form_label(resetForm.newPassword.first, null, {
                                'label_attr': {
                                    'class': 'form-label fw-bold'
                                }
                            }) }}
                            
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                {{ form_widget(resetForm.newPassword.first, {
                                    'attr': {
                                        'class': 'form-control' ~ (resetForm.newPassword.first.vars.errors|length ? ' is-invalid' : ''),
                                        'placeholder': 'Nouveau mot de passe',
                                        'autocomplete': 'new-password'
                                    }
                                }) }}
                                <button class="btn btn-outline-secondary toggle-password" type="button" data-target="newPassword_first">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Minimum 6 caractères
                            </div>
                            
                            {% if resetForm.newPassword.first.vars.errors %}
                                <div class="invalid-feedback d-block">
                                    {% for error in resetForm.newPassword.first.vars.errors %}
                                        <i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            
                            {# Indicateur de force du mot de passe #}
                            <div class="password-strength mt-2">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                                <small class="text-muted strength-text">Force du mot de passe</small>
                            </div>
                        </div>

                        {# Confirmation du mot de passe #}
                        <div class="mb-4">
                            {{ form_label(resetForm.newPassword.second, null, {
                                'label_attr': {
                                    'class': 'form-label fw-bold'
                                }
                            }) }}
                            
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                {{ form_widget(resetForm.newPassword.second, {
                                    'attr': {
                                        'class': 'form-control' ~ (resetForm.newPassword.second.vars.errors|length ? ' is-invalid' : ''),
                                        'placeholder': 'Confirmez le mot de passe',
                                        'autocomplete': 'new-password'
                                    }
                                }) }}
                                <button class="btn btn-outline-secondary toggle-password" type="button" data-target="newPassword_second">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Les deux mots de passe doivent correspondre
                            </div>
                            
                            {% if resetForm.newPassword.second.vars.errors %}
                                <div class="invalid-feedback d-block">
                                    {% for error in resetForm.newPassword.second.vars.errors %}
                                        <i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            
                            {# Indicateur de correspondance #}
                            <div class="password-match mt-2">
                                <small class="text-muted match-text">
                                    <i class="fas fa-check-circle me-1 d-none text-success"></i>
                                    <i class="fas fa-times-circle me-1 d-none text-danger"></i>
                                    Les mots de passe ne correspondent pas encore
                                </small>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-2"></i>Réinitialiser le mot de passe
                            </button>
                        </div>
                    {{ form_end(resetForm) }}

                    <div class="text-center mt-4 pt-3 border-top">
                        <a href="{{ path('app_login') }}" class="text-decoration-none">
                            <i class="fas fa-sign-in-alt me-2"></i>Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-light text-center mt-4">
                <i class="fas fa-lightbulb me-2"></i>
                <strong>Conseils de sécurité :</strong>
                <small class="text-muted">
                    Utilisez un mot de passe unique que vous n'utilisez nulle part ailleurs
                </small>
            </div>
        </div>
    </div>
</div>

<style>
.card {
    border-radius: 15px;
    border: none;
}

.input-group-text {
    background-color: #f8f9fa;
    border-right: none;
}

.toggle-password {
    border-left: none;
    border-color: #dee2e6;
}

.btn-primary {
    background-color: #2c5f2d;
    border-color: #2c5f2d;
    padding: 12px 24px;
    font-weight: 600;
    transition: all 0.3s;
}

.btn-primary:hover {
    background-color: #1e4620;
    border-color: #1e4620;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(44, 95, 45, 0.3);
}

.alert {
    border-radius: 10px;
    border: none;
}

.password-strength .progress-bar {
    transition: width 0.3s, background-color 0.3s;
}

@media (max-width: 768px) {
    .card-body {
        padding: 2rem !important;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle password visibility
    document.querySelectorAll('.toggle-password').forEach(button => {
        button.addEventListener('click', function() {
            const targetId = this.getAttribute('data-target');
            const targetInput = document.getElementById(targetId);
            
            if (targetInput) {
                const type = targetInput.getAttribute('type') === 'password' ? 'text' : 'password';
                targetInput.setAttribute('type', type);
                
                // Toggle icon
                const icon = this.querySelector('i');
                icon.classList.toggle('fa-eye');
                icon.classList.toggle('fa-eye-slash');
            }
        });
    });
    
    // Password strength indicator
    const passwordInput = document.getElementById('newPassword_first');
    const confirmInput = document.getElementById('newPassword_second');
    const progressBar = document.querySelector('.password-strength .progress-bar');
    const strengthText = document.querySelector('.strength-text');
    const matchCheck = document.querySelector('.password-match .fa-check-circle');
    const matchCross = document.querySelector('.password-match .fa-times-circle');
    const matchText = document.querySelector('.match-text');
    
    function checkPasswordStrength(password) {
        let strength = 0;
        let text = 'Très faible';
        let color = '#dc3545'; // Rouge
        
        // Length check
        if (password.length >= 6) strength += 20;
        if (password.length >= 8) strength += 20;
        if (password.length >= 12) strength += 20;
        
        // Complexity checks
        if (/[A-Z]/.test(password)) strength += 15;
        if (/[0-9]/.test(password)) strength += 15;
        if (/[^A-Za-z0-9]/.test(password)) strength += 10;
        
        // Set text and color based on strength
        if (strength >= 80) {
            text = 'Très fort';
            color = '#28a745'; // Vert
        } else if (strength >= 60) {
            text = 'Fort';
            color = '#17a2b8'; // Bleu
        } else if (strength >= 40) {
            text = 'Moyen';
            color = '#ffc107'; // Jaune
        } else if (strength >= 20) {
            text = 'Faible';
            color = '#fd7e14'; // Orange
        }
        
        // Update UI
        progressBar.style.width = strength + '%';
        progressBar.style.backgroundColor = color;
        strengthText.textContent = 'Force : ' + text;
        strengthText.style.color = color;
    }
    
    function checkPasswordMatch() {
        const password = passwordInput.value;
        const confirm = confirmInput.value;
        
        if (confirm.length === 0) {
            matchCheck.classList.add('d-none');
            matchCross.classList.add('d-none');
            matchText.innerHTML = '<i class="fas fa-info-circle me-1"></i>Confirmez votre mot de passe';
        } else if (password === confirm) {
            matchCheck.classList.remove('d-none');
            matchCross.classList.add('d-none');
            matchText.innerHTML = '<i class="fas fa-check-circle me-1 text-success"></i>Les mots de passe correspondent';
        } else {
            matchCheck.classList.add('d-none');
            matchCross.classList.remove('d-none');
            matchText.innerHTML = '<i class="fas fa-times-circle me-1 text-danger"></i>Les mots de passe ne correspondent pas';
        }
    }
    
    // Event listeners
    passwordInput.addEventListener('input', function() {
        checkPasswordStrength(this.value);
        checkPasswordMatch();
    });
    
    confirmInput.addEventListener('input', checkPasswordMatch);
    
    // Form validation
    const form = document.querySelector('form');
    form.addEventListener('submit', function(e) {
        const password = passwordInput.value;
        const confirm = confirmInput.value;
        
        // Check minimum length
        if (password.length < 6) {
            e.preventDefault();
            e.stopPropagation();
            passwordInput.classList.add('is-invalid');
            
            // Show error message
            const errorDiv = passwordInput.parentElement.nextElementSibling;
            if (errorDiv && errorDiv.classList.contains('form-text')) {
                errorDiv.innerHTML = '<i class="fas fa-exclamation-circle me-1 text-danger"></i>Le mot de passe doit contenir au moins 6 caractères';
                errorDiv.classList.add('text-danger');
            }
        } else {
            passwordInput.classList.remove('is-invalid');
        }
        
        // Check password match
        if (password !== confirm) {
            e.preventDefault();
            e.stopPropagation();
            confirmInput.classList.add('is-invalid');
        } else {
            confirmInput.classList.remove('is-invalid');
        }
        
        form.classList.add('was-validated');
    }, false);
    
    // Auto-dismiss alerts after 5 seconds
    setTimeout(() => {
        document.querySelectorAll('.alert').forEach(alert => {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 5000);
    
    // Initialize checks
    checkPasswordStrength(passwordInput.value);
    checkPasswordMatch();
});
</script>
{% endblock %}