            transform: translateX(-5px);
        }

        .password-hint {
            font-size: 0.9rem;
            color: #78909C;
            margin-top: 0.8rem;
            text-align: center;
            font-style: italic;
        }

        .security-note {
            margin-top: 2rem;
            padding: 1rem;
