            }

            .btn {
                padding: 0.9rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <div class="login-icon">🔐</div>
            <h1 class="login-title">Accès Vétérinaire</h1>
            <p class="login-subtitle">Espace sécurisé réservé aux professionnels vétérinaires</p>

            {% for message in app.flashes('error') %}
                <div class="alert alert-error">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <form method="post">
                <div class="form-group">
                    <label class="form-label">Mot de passe vétérinaire :</label>
                    <input type="password" name="password" class="form-control" required
                           placeholder="Entrez votre mot de passe professionnel"
                           autocomplete="current-password">
                </div>

                <input type="hidden" name="user_type" value="veterinary">

                <button type="submit" class="btn btn-primary">
                    🔐 Se connecter
                </button>

                <div class="password-hint">
                    Accès restreint au personnel vétérinaire autorisé
                </div>
            </form>

            <div class="security-note">
                <strong>⚠️ Sécurité :</strong> Cet espace est protégé. Veuillez garder vos identifiants confidentiels.
            </div>

            <a href="{{ path('app_home') }}" class="back-link">
                ← Retour à la page d'accueil
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Focus automatique sur le champ mot de passe
            const passwordInput = document.querySelector('input[name="password"]');
            if (passwordInput) {
                setTimeout(() => {
                    passwordInput.focus();
                }, 300);
            }

            // Animation de soumission
            const form = document.querySelector('form');
            const button = document.querySelector('.btn');

            if (form && button) {
                form.addEventListener('submit', function(e) {
                    const password = document.querySelector('input[name="password"]').value;

                    if (!password.trim()) {
                        e.preventDefault();
                        alert('Veuillez entrer le mot de passe vétérinaire.');
                        return;
                    }

                    button.innerHTML = '🔐 Connexion en cours...';
                    button.disabled = true;
                    button.style.opacity = '0.8';
                });
            }

            // Ajouter un effet visuel sur le champ password au focus
            const passwordField = document.querySelector('input[type="password"]');
            if (passwordField) {
                passwordField.addEventListener('focus', function() {
                    this.style.transform = 'scale(1.02)';
                });

                passwordField.addEventListener('blur', function() {
                    this.style.transform = 'scale(1)';
                });
            }
        });
    </script>
</body>
</html>
