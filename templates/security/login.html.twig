            border-radius: 8px;
            border: 1px dashed #90CAF9;
            color: #546E7A;
            font-size: 0.9rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .login-box {
                padding: 2.5rem 2rem;
            }

            .login-title {
                font-size: 1.8rem;
            }

            .login-icon {
                font-size: 3rem;
            }
        }

