{% extends 'base.html.twig' %}

{% block title %}VetCare - Création de compte{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-user-plus me-2"></i>Création de compte</h4>
                </div>
                <div class="card-body p-4">
                    {{ form_start(registrationForm) }}
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(registrationForm.firstName) }}
                                    {{ form_widget(registrationForm.firstName, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Votre prénom'
                                        }
                                    }) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(registrationForm.lastName) }}
                                    {{ form_widget(registrationForm.lastName, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Votre nom'
                                        }
                                    }) }}
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.email) }}
                            {{ form_widget(registrationForm.email, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'votre@email.com'
                                }
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.plainPassword) }}
                            {{ form_widget(registrationForm.plainPassword, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Choisissez un mot de passe'
                                }
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.phone) }}
                            {{ form_widget(registrationForm.phone, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': '+216 52 666 555'
                                }
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.address) }}
                            {{ form_widget(registrationForm.address, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Votre adresse complète',
                                    'rows': 3
                                }
                            }) }}
                        </div>

                        {# Champ rôle #}
                        <div class="mb-4">
                            {{ form_label(registrationForm.role) }}
                            <div class="role-options">
                                {% for child in registrationForm.role %}
                                    <div class="form-check mb-2">
                                        {{ form_widget(child, {'attr': {'class': 'form-check-input role-radio'}}) }}
                                        <label for="{{ child.vars.id }}" class="form-check-label role-label">
                                            {% if child.vars.value == 'ROLE_USER' %}
                                                <i class="fas fa-user me-2"></i>Utilisateur - Propriétaire d'animal
                                            {% elseif child.vars.value == 'ROLE_VETERINAIRE' %}
                                                <i class="fas fa-stethoscope me-2"></i>Vétérinaire - Professionnel de santé
                                            {% else %}
                                                <i class="fas fa-cog me-2"></i>Administrateur - Gestion de la plateforme
                                            {% endif %}
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-user-plus me-2"></i>Créer le compte
                        </button>
                    {{ form_end(registrationForm) }}

                    <div class="text-center mt-3">
                        <p class="text-muted">
                            Déjà un compte ? 
                            <a href="{{ path('app_login') }}" class="text-decoration-none">Se connecter</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.role-label {
    padding: 10px 15px;
    border: 2px solid #e9ecef;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: block;
    margin-left: 0;
}

.role-label:hover {
    border-color: #007bff;
    background-color: #f8f9fa;
}

.form-check-input:checked + .role-label {
    border-color: #007bff;
    background-color: #e7f3ff;
}
</style>
{% endblock %}