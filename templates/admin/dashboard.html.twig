{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block breadcrumb %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block body %}
<div class="row">
    <!-- Card 1 - Rendez-vous du jour -->
    <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
        <div class="card">
            <div class="card-header p-3 pt-2">
                <div class="icon icon-lg icon-shape bg-gradient-dark shadow-dark text-center border-radius-xl mt-n4 position-absolute">
                    <i class="material-icons opacity-10">calendar_today</i>
                </div>
                <div class="text-end pt-1">
                    <p class="text-sm mb-0 text-capitalize">Rendez-vous du jour</p>
                    <h4 class="mb-0">{{ stats.rdv_today }}</h4>
                </div>
            </div>
            <hr class="dark horizontal my-0">
            <div class="card-footer p-3">
                <p class="mb-0"><span class="text-success text-sm font-weight-bolder">+55% </span>que la semaine dernière</p>
            </div>
        </div>
    </div>

    <!-- Card 2 - En Attente -->
    <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
        <div class="card">
            <div class="card-header p-3 pt-2">
                <div class="icon icon-lg icon-shape bg-gradient-primary shadow-primary text-center border-radius-xl mt-n4 position-absolute">
                    <i class="material-icons opacity-10">schedule</i>
                </div>
                <div class="text-end pt-1">
                    <p class="text-sm mb-0 text-capitalize">En attente</p>
                    <h4 class="mb-0">{{ stats.en_attente }}</h4>
                </div>
            </div>
            <hr class="dark horizontal my-0">
            <div class="card-footer p-3">
                <p class="mb-0"><span class="text-warning text-sm font-weight-bolder">À traiter </span>rapidement</p>
            </div>
        </div>
    </div>

    <!-- Card 3 - Confirmés -->
    <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
        <div class="card">
            <div class="card-header p-3 pt-2">
                <div class="icon icon-lg icon-shape bg-gradient-success shadow-success text-center border-radius-xl mt-n4 position-absolute">
                    <i class="material-icons opacity-10">check_circle</i>
                </div>
                <div class="text-end pt-1">
                    <p class="text-sm mb-0 text-capitalize">Confirmés</p>
                    <h4 class="mb-0">{{ stats.confirmes }}</h4>
                </div>
            </div>
            <hr class="dark horizontal my-0">
            <div class="card-footer p-3">
                <p class="mb-0"><span class="text-success text-sm font-weight-bolder">+3% </span>que le mois dernier</p>
            </div>
        </div>
    </div>

    <!-- Card 4 - Cliniques -->
    <div class="col-xl-3 col-sm-6">
        <div class="card">
            <div class="card-header p-3 pt-2">
                <div class="icon icon-lg icon-shape bg-gradient-info shadow-info text-center border-radius-xl mt-n4 position-absolute">
                    <i class="material-icons opacity-10">local_hospital</i>
                </div>
                <div class="text-end pt-1">
                    <p class="text-sm mb-0 text-capitalize">Cliniques</p>
                    <h4 class="mb-0">{{ stats.cliniques }}</h4>
                </div>
            </div>
            <hr class="dark horizontal my-0">
            <div class="card-footer p-3">
                <p class="mb-0"><span class="text-success text-sm font-weight-bolder">{{ stats.cliniques_actives }} </span>actives</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <!-- Derniers rendez-vous -->
    <div class="col-lg-8 mb-lg-0 mb-4">
        <div class="card">
            <div class="card-header pb-0 p-3">
                <div class="row">
                    <div class="col-6 d-flex align-items-center">
                        <h6 class="mb-0">Derniers rendez-vous</h6>
                    </div>
                    <div class="col-6 text-end">
                        <a class="btn bg-gradient-dark mb-0" href="{{ path('rendezvous_list') }}">
                            <i class="material-icons text-sm">visibility</i>&nbsp;&nbsp;Voir tout
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body p-3">
                {% if derniers_rdv is empty %}
                    <p class="text-center text-muted">Aucun rendez-vous pour le moment</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Client</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Date</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Statut</th>
                                    <th class="text-secondary opacity-7"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rdv in derniers_rdv|slice(0, 6) %}
                                <tr>
                                    <td>
                                        <div class="d-flex px-2 py-1">
                                            <div>
                                                <div class="avatar avatar-sm me-3 bg-gradient-primary">
                                                    <span class="text-white">{{ rdv.nomClient|slice(0, 2)|upper }}</span>
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="mb-0 text-sm">{{ rdv.nomClient }}</h6>
                                                <p class="text-xs text-secondary mb-0">{{ rdv.nomAnimal ?? 'N/A' }}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <p class="text-xs font-weight-bold mb-0">{{ rdv.dateHeure|date('d/m/Y') }}</p>
                                        <p class="text-xs text-secondary mb-0">{{ rdv.dateHeure|date('H:i') }}</p>
                                    </td>
                                    <td class="align-middle text-center text-sm">
                                        <span class="badge badge-sm bg-gradient-{{ rdv.statutBadgeClass }}">
                                            {{ rdv.statut|replace({'_': ' '})|title }}
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <a href="{{ path('rendezvous_edit', {id: rdv.id}) }}" class="text-secondary font-weight-bold text-xs">
                                            <i class="material-icons">edit</i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Vétérinaires actifs -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header pb-0 p-3">
                <h6 class="mb-0">Vétérinaires actifs</h6>
            </div>
            <div class="card-body p-3">
                {% if veterinaires is empty %}
                    <p class="text-muted text-sm">Aucun vétérinaire actif</p>
                {% else %}
                    <ul class="list-group">
                        {% for vet in veterinaires|slice(0, 5) %}
                        <li class="list-group-item border-0 d-flex justify-content-between ps-0 mb-2 border-radius-lg">
                            <div class="d-flex align-items-center">
                                <button class="btn btn-icon-only btn-rounded btn-outline-success mb-0 me-3 p-3 btn-sm d-flex align-items-center justify-content-center">
                                    <i class="material-icons text-lg">person</i>
                                </button>
                                <div class="d-flex flex-column">
                                    <h6 class="mb-1 text-dark text-sm">Dr. {{ vet.prenom }} {{ vet.nom }}</h6>
                                    <span class="text-xs">{{ vet.specialite ?? 'Généraliste' }}</span>
                                    {% if vet.clinique %}
                                        <span class="text-xs text-secondary">
                                            <i class="material-icons text-xs">local_hospital</i>
                                            {{ vet.clinique.nom }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}