{% extends 'backoffice/base.html.twig' %}

{% block title %}Gestion des Traitements{% endblock %}
{% block breadcrumb %}Traitements{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card my-4">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-dark shadow-dark border-radius-lg pt-4 pb-3">
                        <h6 class="text-white text-capitalize ps-3">📋 Gestion des Traitements</h6>
                    </div>
                </div>
                <div class="card-body px-0 pb-2">
                    <div class="text-end pe-3 mb-3">
                        <a href="{{ path('app_traitement_new') }}" class="btn btn-dark btn-sm">
                            ➕ Nouveau traitement
                        </a>
                    </div>

                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Nom</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Description</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Statut</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Médicaments</th>
                                    <th class="text-secondary opacity-7">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if traitements is not empty %}
                                    {% for traitement in traitements %}
                                        <tr>
                                            <td>
                                                <div class="d-flex px-2 py-1">
                                                    <div class="d-flex flex-column justify-content-center">
                                                        <h6 class="mb-0 text-sm">{{ traitement.nom }}</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">
                                                    {{ traitement.description|default('Aucune description')|slice(0, 50) }}{% if traitement.description and traitement.description|length > 50 %}...{% endif %}
                                                </p>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <span class="badge badge-sm 
                                                    {% if traitement.statut == 'pending' %}bg-warning
                                                    {% elseif traitement.statut == 'in_progress' %}bg-info
                                                    {% elseif traitement.statut == 'completed' %}bg-success
                                                    {% elseif traitement.statut == 'cancelled' %}bg-danger
                                                    {% else %}bg-secondary{% endif %}">
                                                    {{ traitement.statut }}
                                                </span>
                                            </td>
                                            <td class="align-middle text-center">
                                                <span class="text-secondary text-xs font-weight-bold">
                                                    {{ traitement.medicaments|length }}
                                                </span>
                                            </td>
                                            <td class="align-middle">
                                                <a href="{{ path('app_traitement_show', {'id': traitement.id}) }}" class="btn btn-info btn-sm">
                                                    👁️
                                                </a>
                                                <a href="{{ path('app_traitement_edit', {'id': traitement.id}) }}" class="btn btn-warning btn-sm">
                                                    ✏️
                                                </a>
                                                <form method="post" action="{{ path('app_traitement_delete', {'id': traitement.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ traitement.id) }}">
                                                    <button class="btn btn-danger btn-sm">🗑️</button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4">
                                            Aucun traitement trouvé
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}