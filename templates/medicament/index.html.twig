{% extends 'base.html.twig' %}

{% block title %}Gestion des Médicaments - PetCare{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">
            <i class="fas fa-pills me-3"></i>Gestion des Médicaments
        </h1>
        <p class="lead">Gérez votre inventaire de médicaments vétérinaires</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">Liste des Médicaments</h2>
        <a href="{{ path('medicament_new') }}" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Nouveau Médicament
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="text-center">ID</th>
                            <th>Nom du Médicament</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for medicament in medicaments %}
                        <tr class="hover-row">
                            <td class="text-center">
                                <span class="badge bg-primary rounded-pill">#{{ medicament.id }}</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-pills text-primary me-2"></i>
                                    <strong>{{ medicament.nom }}</strong>
                                </div>
                            </td>
                            <td>
                                {% if medicament.description %}
                                    <div class="text-muted small">
                                        {{ medicament.description|slice(0, 80) }}{% if medicament.description|length > 80 %}...{% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted small">Aucune description</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('medicament_edit', {'id': medicament.id}) }}"
                                       class="btn btn-outline-warning"
                                       data-bs-toggle="tooltip"
                                       title="Modifier le médicament">
                                        <i class="fas fa-edit"></i>
                                        <span class="d-none d-md-inline ms-1">Modifier</span>
                                    </a>
                                    <form method="post"
                                          action="{{ path('medicament_delete', {'id': medicament.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce médicament?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ medicament.id) }}">
                                        <button type="submit"
                                                class="btn btn-outline-danger"
                                                data-bs-toggle="tooltip"
                                                title="Supprimer le médicament">
                                            <i class="fas fa-trash"></i>
                                            <span class="d-none d-md-inline ms-1">Supprimer</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <div class="empty-state">
                                    <i class="fas fa-pills fa-3x mb-3 text-muted"></i>
                                    <h4 class="text-muted">Aucun médicament trouvé</h4>
                                    <p class="text-muted">Commencez par créer votre premier médicament</p>
                                    <a href="{{ path('medicament_new') }}" class="btn btn-primary mt-2">
                                        <i class="fas fa-plus-circle me-2"></i>Créer un médicament
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Initialiser les tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })
</script>
{% endblock %}