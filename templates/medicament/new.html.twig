{% extends 'base.html.twig' %}

{% block title %}{% if medicament.id %}Modifier{% else %}Nouveau{% endif %} Médicament - PetCare{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-{% if medicament.id %}edit{% else %}plus-circle{% endif %} me-2"></i>
                    {% if medicament.id %}Modifier le Médicament{% else %}Nouveau Médicament{% endif %}
                </h4>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

                <div class="mb-3">
                    {{ form_label(form.nom, 'Nom du médicament', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                    <div class="invalid-feedback">
                        Veuillez saisir un nom pour le médicament.
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-success me-md-2">
                        <i class="fas fa-save me-2"></i>
                        {% if medicament.id %}Modifier{% else %}Créer{% endif %} le médicament
                    </button>
                    <a href="{{ path('medicament_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}