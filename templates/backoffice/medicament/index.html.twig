            </div>

            <div class="form-group">
                <label class="form-label">Stock :</label>
                <select name="stock" class="form-control">
                    <option value="">Tous les stocks</option>
                    <option value="low" {{ currentStock == 'low' ? 'selected' : '' }}>📉 Stock faible (&lt; 5)</option>
                    <option value="medium" {{ currentStock == 'medium' ? 'selected' : '' }}>📊 Stock moyen (5-20)</option>
                    <option value="high" {{ currentStock == 'high' ? 'selected' : '' }}>📈 Stock élevé (&gt; 20)</option>
                </select>
            </div>

            <div style="display: flex; gap: 0.5rem; align-items: flex-end;">
