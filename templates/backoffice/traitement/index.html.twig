{% extends 'backoffice/base.html.twig' %}

{% block title %}Gestion des Traitements{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h1 class="page-title">📋 Gestion des Traitements</h1>
    </div>
    <div class="card-body">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <a href="{{ path('app_traitement_new') }}" class="btn btn-primary">
                ➕ Ajouter un traitement
            </a>
            <div style="color: #6c757d; font-size: 0.9rem;">
                Total: {{ traitements|length }} traitement(s)
            </div>
        </div>

        <!-- Filtres avancés -->
        <div class="card" style="margin-bottom: 2rem;">
            <div class="card-header">
                <h3 style="margin: 0; color: white;">🔍 Recherche & Filtres</h3>
            </div>
            <div class="card-body">
                <form method="get" action="{{ path('app_traitement_index') }}" class="filter-form">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="search">Recherche</label>
                                <input type="text" class="form-control" id="search" name="search"
                                       value="{{ search }}" placeholder="Nom ou description...">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="statut">Statut</label>
                                <select class="form-control" id="statut" name="statut">
                                    <option value="">Tous les statuts</option>
                                    <option value="pending" {{ statut == 'pending' ? 'selected' : '' }}>⏳ En attente</option>
                                    <option value="in_progress" {{ statut == 'in_progress' ? 'selected' : '' }}>🔄 En cours</option>
                                    <option value="completed" {{ statut == 'completed' ? 'selected' : '' }}>✅ Terminé</option>
                                    <option value="cancelled" {{ statut == 'cancelled' ? 'selected' : '' }}>❌ Annulé</option>
                                    <option value="accepted" {{ statut == 'accepted' ? 'selected' : '' }}>👍 Accepté</option>
                                    <option value="refused" {{ statut == 'refused' ? 'selected' : '' }}>👎 Refusé</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="sortBy">Trier par</label>
                                <select class="form-control" id="sortBy" name="sortBy">
                                    <option value="nom" {{ sortBy == 'nom' ? 'selected' : '' }}>Nom</option>
                                    <option value="statut" {{ sortBy == 'statut' ? 'selected' : '' }}>Statut</option>
                                    <option value="dateCreation" {{ sortBy == 'dateCreation' ? 'selected' : '' }}>Date création</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="order">Ordre</label>
                                <select class="form-control" id="order" name="order">
                                    <option value="ASC" {{ order == 'ASC' ? 'selected' : '' }}>↑</option>
                                    <option value="DESC" {{ order == 'DESC' ? 'selected' : '' }}>↓</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="actions" style="margin-top: 1rem;">
                        <button type="submit" class="btn btn-primary">Filtrer</button>
                        <a href="{{ path('app_traitement_index') }}" class="btn btn-secondary">Réinitialiser</a>
                    </div>
                </form>

                {% if search or statut %}
                <div style="margin-top: 1rem; padding: 1rem; background-color: #f8f9fa; border-radius: 5px;">
                    <strong>Filtres actifs :</strong>
                    {% if search %}<span class="badge badge-info">Recherche: "{{ search }}"</span>{% endif %}
                    {% if statut %}
                        <span class="badge badge-info">
                            Statut:
                            {% if statut == 'pending' %}⏳ En attente
                            {% elseif statut == 'in_progress' %}🔄 En cours
                            {% elseif statut == 'completed' %}✅ Terminé
                            {% elseif statut == 'cancelled' %}❌ Annulé
                            {% elseif statut == 'accepted' %}👍 Accepté
                            {% elseif statut == 'refused' %}👎 Refusé
                            {% endif %}
                        </span>
                    {% endif %}
                    <span class="badge badge-info">Tri: {{ sortBy }} ({{ order == 'ASC' ? 'Croissant' : 'Décroissant' }})</span>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Fenêtre de recherche rapide dans le tableau -->
        <div class="card" style="margin-bottom: 2rem;">
            <div class="card-header">
                <h3 style="margin: 0; color: white;">🔎 Recherche Rapide dans le Tableau</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <input type="text" id="tableSearch" class="form-control"
                           placeholder="Rechercher dans le tableau (nom, description, statut...)">
                </div>
                <div class="search-info">
                    <small id="searchResults">Tapez pour filtrer les résultats...</small>
                </div>
            </div>
        </div>

        <table class="table" id="traitementsTable">
            <thead>
                <tr>
                    <th>
                        <a href="?sortBy=nom&order={{ sortBy == 'nom' and order == 'ASC' ? 'DESC' : 'ASC' }}{% if search %}&search={{ search }}{% endif %}{% if statut %}&statut={{ statut }}{% endif %}">
                            ID {% if sortBy == 'nom' %}{{ order == 'ASC' ? '↑' : '↓' }}{% endif %}
                        </a>
                    </th>
                    <th>
                        <a href="?sortBy=nom&order={{ sortBy == 'nom' and order == 'ASC' ? 'DESC' : 'ASC' }}{% if search %}&search={{ search }}{% endif %}{% if statut %}&statut={{ statut }}{% endif %}">
                            Nom {% if sortBy == 'nom' %}{{ order == 'ASC' ? '↑' : '↓' }}{% endif %}
                        </a>
                    </th>
                    <th>Description</th>
                    <th>
                        <a href="?sortBy=statut&order={{ sortBy == 'statut' and order == 'ASC' ? 'DESC' : 'ASC' }}{% if search %}&search={{ search }}{% endif %}{% if statut %}&statut={{ statut }}{% endif %}">
                            Statut {% if sortBy == 'statut' %}{{ order == 'ASC' ? '↑' : '↓' }}{% endif %}
                        </a>
                    </th>
                    <th>Médicaments</th>
                    <th>
                        <a href="?sortBy=dateCreation&order={{ sortBy == 'dateCreation' and order == 'ASC' ? 'DESC' : 'ASC' }}{% if search %}&search={{ search }}{% endif %}{% if statut %}&statut={{ statut }}{% endif %}">
                            Date création {% if sortBy == 'dateCreation' %}{{ order == 'ASC' ? '↑' : '↓' }}{% endif %}
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for traitement in traitements %}
                <tr>
                    <td><strong>#{{ traitement.id }}</strong></td>
                    <td>
                        <div style="font-weight: 600; color: #2c3e50;">{{ traitement.nom }}</div>
                    </td>
                    <td>
                        <div style="max-width: 200px;">
                            {{ traitement.description|default('Aucune description')|slice(0, 60) }}
                            {% if traitement.description and traitement.description|length > 60 %}...{% endif %}
                        </div>
                    </td>
                    <td>
                        <span class="statut-badge statut-{{ traitement.statut }}">
                            {% if traitement.statut == 'pending' %}⏳ En attente
                            {% elseif traitement.statut == 'in_progress' %}🔄 En cours
                            {% elseif traitement.statut == 'completed' %}✅ Terminé
                            {% elseif traitement.statut == 'cancelled' %}❌ Annulé
                            {% elseif traitement.statut == 'accepted' %}👍 Accepté
                            {% elseif traitement.statut == 'refused' %}👎 Refusé
                            {% endif %}
                        </span>
                    </td>
                    <td>
                        {% if traitement.medicaments|length > 0 %}
                            <span style="color: #27ae60; font-weight: 600;">{{ traitement.medicaments|length }}</span> médicament(s)
                        {% else %}
                            <span style="color: #6c757d;">Aucun</span>
                        {% endif %}
                    </td>
                    <td>{{ traitement.dateCreation|date('d/m/Y H:i') }}</td>
                    <td>
                        <div class="actions">
                            <a href="{{ path('app_traitement_show', {'id': traitement.id}) }}" class="btn btn-info" title="Voir détails">
                                👁️
                            </a>
                            <a href="{{ path('app_traitement_edit', {'id': traitement.id}) }}" class="btn btn-warning" title="Modifier">
                                ✏️
                            </a>
                            <form method="post" action="{{ path('app_traitement_delete', {'id': traitement.id}) }}"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce traitement ?');"
                                  style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ traitement.id) }}">
                                <button class="btn btn-secondary" title="Supprimer">🗑️</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align: center; padding: 2rem; color: #6c757d;">
                        <div style="font-size: 1.2rem; margin-bottom: 0.5rem;">📭</div>
                        Aucun traitement trouvé
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
// Recherche en temps réel dans le tableau
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('tableSearch');
    const searchResults = document.getElementById('searchResults');
    const table = document.getElementById('traitementsTable');

    if (searchInput && table) {
        searchInput.addEventListener('keyup', function() {
            const searchTerm = this.value.toLowerCase().trim();
            const rows = table.querySelectorAll('tbody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                // Vérifier si c'est la ligne "vide" (pas de traitements)
                if (row.querySelector('td[colspan]')) {
                    // Si c'est la ligne vide, on la cache si on recherche
                    row.style.display = searchTerm === '' ? '' : 'none';
                    return;
                }

                const rowText = row.textContent.toLowerCase();
                const isVisible = searchTerm === '' || rowText.includes(searchTerm);

                if (isVisible) {
                    row.style.display = '';
                    visibleCount++;

                    // Surligner le texte correspondant
                    if (searchTerm.length > 0) {
                        highlightText(row, searchTerm);
                    } else {
                        removeHighlight(row);
                    }
                } else {
                    row.style.display = 'none';
                }
            });

            // Mettre à jour le compteur
            if (searchResults) {
                if (searchTerm.length > 0) {
                    searchResults.textContent = `${visibleCount} traitement(s) trouvé(s) sur {{ traitements|length }}`;
                    searchResults.style.color = visibleCount > 0 ? '#28a745' : '#dc3545';
                } else {
                    searchResults.textContent = `Tapez pour filtrer les {{ traitements|length }} traitement(s)`;
                    searchResults.style.color = '#6c757d';
                }
            }
        });

        // Mettre le focus sur la recherche
        searchInput.focus();
    }

    // Fonction pour surligner le texte
    function highlightText(row, searchTerm) {
        const cells = row.querySelectorAll('td');
        cells.forEach(cell => {
            // Éviter les cellules avec des boutons
            if (cell.querySelector('.actions')) return;

            const originalText = cell.textContent;
            const regex = new RegExp(`(${searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            const highlightedText = originalText.replace(regex, '<mark>$1</mark>');
            cell.innerHTML = highlightedText;
        });
    }

    // Fonction pour retirer le surlignage
    function removeHighlight(row) {
        const cells = row.querySelectorAll('td');
        cells.forEach(cell => {
            // Éviter les cellules avec des boutons
            if (cell.querySelector('.actions')) return;

            // Rétablir le texte original
            const span = cell.querySelector('span.statut-badge');
            if (span) {
                // Pour les cellules avec statut-badge
                cell.innerHTML = span.outerHTML;
            } else {
                cell.innerHTML = cell.textContent;
            }
        });
    }
});
</script>

<style>
.search-info {
    margin-top: 0.5rem;
    padding: 0.5rem;
    background: #f8f9fa;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: color 0.3s;
}

/* Surlignage des résultats */
mark {
    background-color: #ffeb3b;
    padding: 0.1rem 0.2rem;
    border-radius: 2px;
    font-weight: bold;
}

/* Badge pour filtres actifs */
.badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;
    border-radius: 0.25rem;
    margin-right: 0.5rem;
    margin-bottom: 0.25rem;
}

.badge-info {
    background-color: #17a2b8;
    color: white;
}

/* Filtres responsives */
.filter-form .row {
    display: flex;
    flex-wrap: wrap;
    margin: -0.5rem;
}

.filter-form .col-md-2, .filter-form .col-md-3, .filter-form .col-md-4 {
    padding: 0.5rem;
}

@media (max-width: 768px) {
    .filter-form .col-md-2, .filter-form .col-md-3, .filter-form .col-md-4 {
        flex: 0 0 100%;
        max-width: 100%;
    }
}
</style>
{% endblock %}