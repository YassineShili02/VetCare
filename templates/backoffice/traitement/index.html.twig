{% extends 'backoffice/base.html.twig' %}

{% block title %}Gestion des Traitements{% endblock %}

{% block body %}
<!-- FORME DE FILTRAGE -->
<div class="filters-section" style="margin-bottom: 2rem; background: #f8f9fa; padding: 1.5rem; border-radius: 8px;">
    <h3 style="margin-bottom: 1rem; color: #2c3e50;">🔍 Filtres et Tri</h3>

    <form method="get" action="{{ path('app_traitement_index') }}" class="filter-form">
        <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">

            <!-- BARRE DE RECHERCHE -->
            <div class="form-group" style="flex: 1; min-width: 250px;">
                <label for="search" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Recherche :</label>
                <input type="text"
                       id="search"
                       name="search"
                       value="{{ currentSearch }}"
                       class="form-control"
                       placeholder="Nom ou description...">
            </div>

            <!-- FILTRE PAR STATUT -->
            <div class="form-group" style="min-width: 200px;">
                <label for="statut" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Statut :</label>
                <select id="statut" name="statut" class="form-control">
                    {% for key, label in statuts %}
                        <option value="{{ key }}" {{ currentStatut == key ? 'selected' : '' }}>
                            {{ label }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <!-- BOUTONS D'ACTION -->
            <div class="form-group" style="display: flex; gap: 0.5rem;">
                <button type="submit" class="btn btn-primary" style="white-space: nowrap;">
                    🔍 Appliquer les filtres
                </button>
                <a href="{{ path('app_traitement_index') }}" class="btn btn-secondary">
                    🗑️ Réinitialiser
                </a>
            </div>
        </div>
    </form>
</div>

        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Statut</th>
                    <th>Médicaments</th>
                    <th>Date création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for traitement in traitements %}
                <tr>
                    <td><strong>#{{ traitement.id }}</strong></td>
                    <td>
                        <div style="font-weight: 600; color: #2c3e50;">{{ traitement.nom }}</div>
                    </td>
                    <td>
                        <div style="max-width: 200px;">
                            {{ traitement.description|default('Aucune description')|slice(0, 60) }}
                            {% if traitement.description and traitement.description|length > 60 %}...{% endif %}
                        </div>
                    </td>
                    <td>
                        <span class="statut-badge statut-{{ traitement.statut }}">
                            {% if traitement.statut == 'pending' %}⏳ En attente
                            {% elseif traitement.statut == 'in_progress' %}🔄 En cours
                            {% elseif traitement.statut == 'completed' %}✅ Terminé
                            {% elseif traitement.statut == 'cancelled' %}❌ Annulé
                            {% elseif traitement.statut == 'accepted' %}👍 Accepté
                            {% elseif traitement.statut == 'refused' %}👎 Refusé
                            {% endif %}
                        </span>
                    </td>
                    <td>
                        {% if traitement.medicaments|length > 0 %}
                            <span style="color: #27ae60; font-weight: 600;">{{ traitement.medicaments|length }}</span> médicament(s)
                        {% else %}
                            <span style="color: #6c757d;">Aucun</span>
                        {% endif %}
                    </td>
                    <td>{{ traitement.dateCreation|date('d/m/Y H:i') }}</td>
                    <td>
                        <div class="actions">
                            <a href="{{ path('app_traitement_show', {'id': traitement.id}) }}" class="btn btn-info" title="Voir détails">
                                👁️
                            </a>
                            <a href="{{ path('app_traitement_edit', {'id': traitement.id}) }}" class="btn btn-warning" title="Modifier">
                                ✏️
                            </a>
                            <form method="post" action="{{ path('app_traitement_delete', {'id': traitement.id}) }}"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce traitement ?');"
                                  style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ traitement.id) }}">
                                <button class="btn btn-secondary" title="Supprimer">🗑️</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align: center; padding: 2rem; color: #6c757d;">
                        <div style="font-size: 1.2rem; margin-bottom: 0.5rem;">📭</div>
                        Aucun traitement trouvé
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}