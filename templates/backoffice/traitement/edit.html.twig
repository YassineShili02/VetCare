{% extends 'backoffice/base.html.twig' %}

{% block title %}Modifier le Traitement{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h1 style="margin: 0; color: white;">Modifier le traitement</h1>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.nom) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group">
                {{ form_label(form.statut) }}
                {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.statut) }}
            </div>

            <div class="form-group">
                {{ form_label(form.medicaments) }}
                {{ form_widget(form.medicaments, {'attr': {'class': 'form-control', 'style': 'height: 150px;'}}) }}
                {{ form_errors(form.medicaments) }}
                <small class="text-muted">Maintenez Ctrl (ou Cmd sur Mac) pour sélectionner plusieurs médicaments</small>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-success">Modifier</button>
                <a href="{{ path('app_traitement_index') }}" class="btn btn-primary">Retour à la liste</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}